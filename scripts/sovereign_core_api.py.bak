    con = sqlite3.connect(DB_PATH)
    cur = con.cursor()
    try:
        cur.execute("DELETE FROM cmdb_ci_appl WHERE sys_id = ?", (sys_id,))
        cur.execute("DELETE FROM cmdb_ci WHERE sys_id = ?", (sys_id,))
        con.commit()
        return {"status": "success"}
