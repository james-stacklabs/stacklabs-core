# ==============================================================================
from typing import Dict, Any, List

_active_polls: Dict[str, Dict[str, Any]] = {
    "default": {
        "id": "poll-subway-001",
        "room_id": "watch-party-main",
        "question": "Will Pete Alonso hit a home run this at-bat against the Yankees?",
        "options": [
            {"id": "opt-yes", "text": "YES! Outta here into the bullpen!", "votes": 14, "voters": ["Metsy", "Pawel", "pilot_user"]},
            {"id": "opt-no", "text": "NO, slider away gets him chasing", "votes": 9, "voters": ["Keith_Hernandez"]},
            {"id": "opt-barf", "text": "BARF! Only if he brings me a hot dog!", "votes": 6, "voters": ["Barf"]}
        ],
        "created_at": datetime.now().isoformat(),
        "status": "OPEN",
        "total_votes": 29
    }
}

class CreatePollRequest(BaseModel):
    room_id: str = "watch-party-main"
    question: str
    options: List[str]

class VoteRequest(BaseModel):
    option_id: str
    voter: str = "fan_user"

@app.get("/api/fanstack/polls/active")
@app.get("/api/sports/polls/room/{room_id}/active")
def get_active_poll(room_id: str = "watch-party-main"):
    poll = _active_polls.get(room_id) or _active_polls.get("default")
    return poll or {"status": "NO_ACTIVE_POLL"}

@app.post("/api/fanstack/polls")
@app.post("/api/sports/polls/create")
def create_poll(req: CreatePollRequest):
    import time
    poll_id = f"poll-{int(time.time())}"
    opts = [{"id": f"opt-{i}", "text": opt_text, "votes": 0, "voters": []} for i, opt_text in enumerate(req.options)]
    new_poll = {
        "id": poll_id,
        "room_id": req.room_id,
        "question": req.question,
        "options": opts,
        "created_at": datetime.now().isoformat(),
        "status": "OPEN",
        "total_votes": 0
    }
    _active_polls[req.room_id] = new_poll
    _active_polls["default"] = new_poll
    return new_poll

@app.post("/api/fanstack/polls/{poll_id}/vote")
@app.post("/api/sports/polls/{poll_id}/vote")
def cast_poll_vote(poll_id: str, req: VoteRequest):
    for room_key, poll in _active_polls.items():
        if poll.get("id") == poll_id or poll_id == "active":
            if poll.get("status") != "OPEN":
                raise HTTPException(status_code=400, detail="Poll is closed")
            for opt in poll["options"]:
                if opt["id"] == req.option_id:
                    if req.voter not in opt["voters"]:
                        opt["voters"].append(req.voter)
                        opt["votes"] += 1
                        poll["total_votes"] += 1
                    return poll
            raise HTTPException(status_code=404, detail="Option not found")
    raise HTTPException(status_code=404, detail="Poll not found")

@app.post("/api/fanstack/polls/{poll_id}/close")
@app.post("/api/sports/polls/{poll_id}/close")
def close_poll(poll_id: str):
    for room_key, poll in _active_polls.items():
        if poll.get("id") == poll_id or poll_id == "active":
            poll["status"] = "CLOSED"
            return poll
    raise HTTPException(status_code=404, detail="Poll not found")


# ── SYSTEM POLLER STATUS & HEARTBEAT MONITOR (WO0010108) ────────────────────

@app.get("/api/system/pollers/status")
async def get_pollers_status():
    """Retrieve live heartbeat telemetry and systemd process health for Sovereign background pollers."""
    from pathlib import Path
    now = time.time()
    
    # 1. Scratchpad Poller
    scratchpad_hb_file = Path("/home/james/SovereignOS/logs/scratch_pad_poller_heartbeat.json")
    scratchpad_info = {
        "service_name": "scratch-pad-poller.service",
        "active": False,
        "pid": None,
        "poll_count": 0,
        "seconds_since_heartbeat": None,
        "status": "STOPPED",
        "scratch_pad_sha256": "",
        "unresolved_tasks_count": 0,
        "last_heartbeat_iso": None
    }
    if scratchpad_hb_file.exists():
        try:
            with open(scratchpad_hb_file, "r") as f:
                data = json.load(f)
                ts = data.get("timestamp", 0)
                sec_ago = max(0.0, round(now - ts, 2))
                scratchpad_info.update({
                    "active": sec_ago < 10.0,
                    "pid": data.get("pid"),
                    "poll_count": data.get("poll_count", 0),
                    "seconds_since_heartbeat": sec_ago,
                    "status": data.get("status", "LISTENING") if sec_ago < 10.0 else "STALE",
                    "scratch_pad_sha256": data.get("scratch_pad_sha256", ""),
                    "unresolved_tasks_count": data.get("unresolved_tasks_count", 0),
                    "last_heartbeat_iso": data.get("iso_time")
                })
        except Exception as e:
            scratchpad_info["error"] = str(e)

    # 2. FanStack Poller
    fanstack_hb_file = Path("/home/james/SovereignOS/logs/fanstack_poller_heartbeat.json")
    fanstack_info = {
        "service_name": "fanstack-poller.service",
        "active": False,
        "pid": None,
        "seconds_since_heartbeat": None,
        "status": "STOPPED",
        "active_games_count": 0,
        "last_play_desc": "",
        "last_heartbeat_iso": None
    }
    if fanstack_hb_file.exists():
        try:
            with open(fanstack_hb_file, "r") as f:
                data = json.load(f)
                ts = data.get("timestamp", 0)
                sec_ago = max(0.0, round(now - ts, 2))
                fanstack_info.update({
                    "active": sec_ago < 15.0,
                    "pid": data.get("pid"),
                    "seconds_since_heartbeat": sec_ago,
                    "status": data.get("status", "STREAMING") if sec_ago < 15.0 else "STALE",
                    "active_games_count": data.get("active_games_count", 0),
                    "last_play_desc": data.get("last_play_desc", ""),
                    "last_heartbeat_iso": data.get("iso_time")
                })
        except Exception as e:
            fanstack_info["error"] = str(e)

    import datetime as _dt
    return {
        "status": "success",
        "timestamp": now,
        "iso_time": _dt.datetime.now(_dt.timezone.utc).isoformat(),
        "pollers": {
            "scratch_pad_poller": scratchpad_info,
            "fanstack_poller": fanstack_info
        }
    }


