        c.execute("""
            SELECT id, ticket_id, name, slug, expression_reference, vibe, prompt, status, created_at, updated_at 
            FROM metsy_adventure_stage 
            WHERE status != 'Completed'
            ORDER BY created_at DESC
        """)
