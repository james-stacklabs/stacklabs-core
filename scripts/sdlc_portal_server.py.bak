# ── PROSPECT RECON SENTINEL (TOOL #49) ──────────────────────

RECON_DB_PATH = "/home/james/SovereignOS/dna/recon_sentinel.db"

@app.get("/api/recon/prospects")
def get_recon_prospects_endpoint():
    """Retrieve all audited prospects from recon_sentinel.db."""
    if not os.path.exists(RECON_DB_PATH):
        return []
    with sqlite3.connect(RECON_DB_PATH) as conn:
        conn.row_factory = sqlite3.Row
        rows = conn.execute("SELECT * FROM prospects ORDER BY created_at DESC").fetchall()
        return [dict(r) for r in rows]

@app.get("/api/recon/prospects/{slug}")
def get_recon_prospect_detail_endpoint(slug: str):
    """Retrieve prospect details, runs, and keyword results from recon_sentinel.db."""
    if not os.path.exists(RECON_DB_PATH):
        raise HTTPException(status_code=404, detail="Recon database not found")
    with sqlite3.connect(RECON_DB_PATH) as conn:
        conn.row_factory = sqlite3.Row
        prospect = conn.execute("SELECT * FROM prospects WHERE prospect_id = ?", (slug,)).fetchone()
        if not prospect:
            raise HTTPException(status_code=404, detail=f"Prospect '{slug}' not found")
        runs = conn.execute("SELECT * FROM serp_audit_runs WHERE prospect_id = ? ORDER BY executed_at DESC", (slug,)).fetchall()
        keywords = conn.execute("SELECT * FROM target_keywords WHERE prospect_id = ?", (slug,)).fetchall()
        results = conn.execute(
            """
            SELECT skr.*, tk.keyword, tk.estimated_ticket_value, tk.intent_category
            FROM serp_keyword_results skr
            JOIN target_keywords tk ON skr.keyword_id = tk.keyword_id
            WHERE tk.prospect_id = ?
            ORDER BY skr.created_at DESC
            """,
            (slug,)
        ).fetchall()
        return {
            "prospect": dict(prospect),
            "runs": [dict(r) for r in runs],
            "keywords": [dict(k) for k in keywords],
            "results": [dict(res) for res in results]
        }


@app.post("/api/ingress/voice-drop")
async def handle_voice_drop(
    audio: UploadFile = File(...),
    sender: str = Form("guest"),
    source_route: str = Form("/drop"),
    council_memo: Optional[str] = Form(None)
):
    """
    Ingests voice problem drop from public web edge (SOW-042).
    Saves raw audio, transcribes, notifies pilot, returns transcript.
    """
    import os, time, datetime
    from pathlib import Path

    drop_dir = Path("/home/james/sovereign_inbox/pilot_drops/voice_drops")
    drop_dir.mkdir(parents=True, exist_ok=True)

    timestamp_str = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    drop_id = f"DROP_{timestamp_str}_{sender[:10]}"
    file_ext = audio.filename.split(".")[-1] if audio.filename and "." in audio.filename else "webm"
    save_path = drop_dir / f"{drop_id}.{file_ext}"

    content = await audio.read()
    with open(save_path, "wb") as f:
        f.write(content)

    # Transcription cascade: Try Gemini API if key present, else fallback placeholder
    transcript = ""
    try:
        gemini_api_key = os.getenv("GEMINI_API_KEY")
        if not gemini_api_key:
            load_dotenv("/home/james/SovereignOS/.env")
            gemini_api_key = os.getenv("GEMINI_API_KEY")
        if gemini_api_key:
            from google import genai
            client = genai.Client(api_key=gemini_api_key)
            audio_file = client.files.upload(file=str(save_path))
            response = client.models.generate_content(
                model="gemini-3.8-flash",
                contents=[audio_file, "Transcribe this audio recording verbatim. Provide only the plain text transcription without commentary."]
            )
            transcript = response.text.strip()
    except Exception as e:
        logger.error(f"[VOICE_DROP] Transcription notice: {e}")
        try:
            import whisper
            model = whisper.load_model("base.en")
            res = model.transcribe(str(save_path))
            transcript = res["text"].strip()
        except Exception as we:
            logger.error(f"[VOICE_DROP] Whisper fallback error: {we}")

    if not transcript:
        transcript = f"Audio problem statement received ({len(content)} bytes). Triage active in forge."

    # Append notification to pilot_scratch_pad.md and scratch_pad.md
    for scratch_file in ["pilot_scratch_pad.md", "scratch_pad.md"]:
        scratchpad_path = Path("/home/james/sovereign_inbox/pilot_drops") / scratch_file
        if scratchpad_path.exists():
            memo_block = f"\n- **MARD Blueprint Attached**:\n```\n{council_memo}\n```" if council_memo else ""
            entry = (
                f"\n\n### 🎙️ [VOICE DROP RECEIVED] {sender.upper()}\n"
                f"- **Timestamp**: {datetime.now().isoformat()}\n"
                f"- **Drop ID**: `{drop_id}`\n"
                f"- **Audio File**: `{save_path}`\n"
                f"- **Transcript**: \"{transcript}\""
                f"{memo_block}\n"
                f"- **Action**: Rapid prototype turnaround dispatched (Target: < 4 hours).\n"
            )
            with open(scratchpad_path, "a") as f:
                f.write(entry)

    return {
        "status": "success",
        "drop_id": drop_id,
        "transcript": transcript,
        "sender": sender,
        "council_memo": council_memo,
        "turnaround_hours": 4,
        "message": "Problem received and routed to StackLabs Edge Forge."
    }


@app.post("/api/transcribe")
async def api_transcribe(audio: UploadFile = File(...)):
    """Transcribes uploaded audio using Gemini 3.8 Flash via google.genai SDK."""
    from google import genai
    import os, tempfile
    
    key = os.getenv("GEMINI_API_KEY")
    if not key:
        load_dotenv("/home/james/SovereignOS/.env")
        key = os.getenv("GEMINI_API_KEY")
    if not key:
        return {"status": "error", "message": "GEMINI_API_KEY missing"}
    
    client = genai.Client(api_key=key)
    content = await audio.read()
    
    file_ext = os.path.splitext(audio.filename)[1] if audio.filename and "." in audio.filename else ".webm"
    if not file_ext.startswith("."):
        file_ext = f".{file_ext}"

    with tempfile.NamedTemporaryFile(suffix=file_ext, delete=False) as tmp:
        tmp.write(content)
        tmp_path = tmp.name
        
    try:
        audio_file = client.files.upload(file=tmp_path)
        response = client.models.generate_content(
            model="gemini-3.8-flash",
            contents=[audio_file, "Transcribe this audio recording verbatim. Provide only the plain text transcription without any commentary or quotation marks."]
        )
        transcript = response.text.strip()
        return {"status": "success", "transcript": transcript}
    except Exception as e:
        logger.error(f"Cloud transcription error: {e}")
        # Fallback to local whisper
        try:
            import whisper
            model = whisper.load_model("base.en")
            res = model.transcribe(tmp_path)
            return {"status": "success", "transcript": res["text"].strip()}
        except Exception as we:
            return {"status": "error", "message": str(e)}
    finally:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)


@app.post("/api/tts")
async def api_tts(payload: dict = Body(...)):
    """Generates slick studio audio using Gemini 3.8 Flash TTS with Orbit voice."""
    from google import genai
    from google.genai import types
    from fastapi.responses import Response
    import os
    
    text = payload.get("text", "")
    voice = payload.get("voice", "Orbit")
    
    key = os.getenv("GEMINI_API_KEY")
    if not key:
        load_dotenv("/home/james/SovereignOS/.env")
        key = os.getenv("GEMINI_API_KEY")
    if not key:
        return {"status": "error", "message": "GEMINI_API_KEY missing"}
        
    client = genai.Client(api_key=key)
    try:
        response = client.models.generate_content(
            model="gemini-3.8-flash-tts",
            contents=text,
            config=types.GenerateContentConfig(
                response_modalities=["AUDIO"],
                speech_config=types.SpeechConfig(
                    voice_config=types.VoiceConfig(
                        prebuilt_voice_config=types.PrebuiltVoiceConfig(
                            voice_name=voice
                        )
                    )
                )
            )
        )
        audio_bytes = response.candidates[0].content.parts[0].inline_data.data
        return Response(content=audio_bytes, media_type="audio/wav")
    except Exception as e:
        logger.error(f"TTS generation error: {e}")
        return {"status": "error", "message": str(e)}


