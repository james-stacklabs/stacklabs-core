@app.post("/api/antigravity/chat")
async def post_antigravity_chat(req: AntigravityChatRequest):
    """Conversational endpoint for Pilot James on mobile to talk directly to Antigravity AI."""
    # [Hoisted to header] import requests
    # [Hoisted to header] from dotenv import load_dotenv
    load_dotenv("/home/james/SovereignOS/.env")
    gemini_key = os.getenv("GEMINI_API_KEY")

    user_msg = req.message.strip()
    if not user_msg:
        return JSONResponse({"reply": "Awaiting your transmission, Pilot."}, status_code=200)

    # --------------------------------------------------------------------------
    # AUTONOMOUS MOBILE AGENT BRIDGE EXECUTION ENGINE
    # --------------------------------------------------------------------------

    # 1. SPECIAL COMMAND: /sovereign_boot (Real System Health & Boot Audit)
    if user_msg.lower().startswith("/sovereign_boot"):
        conn = get_db()
        cur = conn.cursor()
        tkt_summary = []
        node_summary = []
        db_wal = "UNKNOWN"
        try:
            cur.execute("SELECT number, short_description, state FROM sovereign_tickets WHERE state IN (1, 2) ORDER BY sys_updated_on DESC LIMIT 5")
            tkt_summary = [f"• `{r[0]}` {r[1]} (State: {r[2]})" for r in cur.fetchall()]
            
            cur.execute("SELECT name, sys_class_name, operational_status FROM cmdb_ci WHERE sys_class_name LIKE '%hardware%' OR sys_class_name = 'cmdb_ci_appl' LIMIT 6")
            node_summary = [f"• {r[0]} ({r[1]} - Status: {r[2]})" for r in cur.fetchall()]

            cur.execute("PRAGMA journal_mode;")
            wal_row = cur.fetchone()
            if wal_row:
                db_wal = wal_row[0].upper()
        except Exception as db_e:
            print(f"[BOOT_CHECK_DB_ERR] {db_e}")
        finally:
            conn.close()

        # Check port statuses
        ports_to_check = [3016, 8095, 8090, 8000, 3010, 3028]
        active_ports = []
        import socket
        for p in ports_to_check:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                s.settimeout(0.5)
                if s.connect_ex(('127.0.0.1', p)) == 0:
                    active_ports.append(str(p))

        boot_report = (
            "🧬 **SOVEREIGN OS MOBILE AGENT BOOT REPORT**\n\n"
            "**Architect:** James Carroll (Lead Systems Architect / Ω Gate)\n"
            "**Execution Context:** Clio Hub Agent Bridge over Tailscale\n\n"
            "📊 **Live Infrastructure State:**\n"
            f"• Database: `/home/james/SovereignOS/dna/sovereign_now.db` (WAL Mode: `{db_wal}`)\n"
            f"• Active Services Listening: {', '.join(active_ports) if active_ports else 'None'}\n\n"
            "🛠️ **Active Work Orders & Tickets:**\n"
            + ("\n".join(tkt_summary) if tkt_summary else "• No pending open work orders.") + "\n\n"
            "🖥️ **CMDB Hardware & Cluster Nodes:**\n"
            + ("\n".join(node_summary) if node_summary else "• Node topology pristine.") + "\n\n"
            "⚡ *Antigravity Mobile Agent active with full execution capabilities.*"
        )
        return {"reply": boot_report, "sender": "Antigravity AI", "timestamp": datetime.now().strftime("%H:%M:%S")}

    # 2. SPECIAL COMMAND: /wo or /ticket (Create Real SDLC Work Order & JIT Approval)
    if user_msg.lower().startswith("/wo") or user_msg.lower().startswith("/ticket") or user_msg.lower().startswith("/workorder"):
        clean_prompt = user_msg
        for prefix in ["/wo", "/ticket", "/workorder"]:
            if clean_prompt.lower().startswith(prefix):
                clean_prompt = clean_prompt[len(prefix):].strip()
                break

        title = clean_prompt if clean_prompt else "Mobile Field Request"
        ts_id = datetime.now().strftime("%Y%m%d%H%M%S")
        tkt_number = f"WO-{ts_id}"
        sys_id_tkt = f"sys_wo_{ts_id}"
        sys_id_app = f"sys_app_{ts_id}"

        conn = get_db()
        cur = conn.cursor()
        try:
            # Create sovereign_ticket
            cur.execute("""
                INSERT INTO sovereign_tickets (sys_id, number, type, short_description, description, state, priority, assigned_to, cmdb_ci, category)
                VALUES (?, ?, 'REQ', ?, ?, 1, 2, 'james', '01_Sovereign_Portal', 'Mobile Ingress')
            """, (sys_id_tkt, tkt_number, title[:100], clean_prompt))

            # Create JIT Approval Queue Record
            cur.execute("""
                INSERT INTO sys_approval_queue (sys_id, task_id, assigned_to, title, plan_markdown, state, auth_level)
                VALUES (?, ?, 'james', ?, ?, 'Requested', 'omega=0')
            """, (sys_id_app, tkt_number, f"Approval: {title[:60]}", f"# Mobile Request Plan\n\n{clean_prompt}"))

            conn.commit()

            # Save note file per KI-050
            note_file = f"/home/james/sovereign_inbox/implementation_plans/implementation_plan_{tkt_number}.md"
            with open(note_file, "w") as f:
                f.write(f"# Implementation Plan: {tkt_number}\n\n**Title:** {title}\n**Origin:** Mobile Antigravity Bridge\n\n{clean_prompt}\n")

            wo_reply = (
                f"✅ **Work Order Created & Staged Successfully!**\n\n"
                f"• **Ticket Number:** `{tkt_number}`\n"
                f"• **Short Description:** {title[:80]}\n"
                f"• **State:** `1 (Open)` | Priority: `2 (High)`\n"
                f"• **JIT Approval Queue:** Staged (`omega=0` pending elevation)\n"
                f"• **Canonical Plan:** `/home/james/sovereign_inbox/implementation_plans/implementation_plan_{tkt_number}.md`\n\n"
                f"⚡ Antigravity Dispatcher has logged this ticket into `sovereign_now.db`."
            )
            return {"reply": wo_reply, "sender": "Antigravity AI", "timestamp": datetime.now().strftime("%H:%M:%S")}
        except Exception as wo_err:
            print(f"[MOBILE_WO_CREATE_ERR] {wo_err}")
            conn.rollback()
            return {"reply": f"⚠️ Failed to create Work Order: {wo_err}", "sender": "Antigravity AI", "timestamp": datetime.now().strftime("%H:%M:%S")}
        finally:
            conn.close()

    # 3. Save Field Note if tagged with /note
    if req.save_note or user_msg.lower().startswith("/note"):
        try:
            note_ts = datetime.now().strftime("%Y%m%d_%H%M%S")
            note_file = f"/home/james/sovereign_inbox/mobile_note_{note_ts}.md"
            with open(note_file, "w") as f:
                f.write(f"# 📱 Pilot Field Note ({note_ts})\n**Sender:** {req.sender}\n\n{user_msg}\n")
        except Exception as e:
            print(f"[NOTE_SAVE_ERR] {e}")

    # Build Sovereign Dynamic Empirical System Context
    conn = get_db()
    cur = conn.cursor()
    recent_tickets = []
    cmdb_nodes = []
    try:
        cur.execute("SELECT number, short_description, state FROM sovereign_tickets ORDER BY sys_updated_on DESC LIMIT 5")
        recent_tickets = [f"- [{r[0]}] {r[1]} (State: {r[2]})" for r in cur.fetchall()]

        cur.execute("SELECT c.name, h.ip_address, c.operational_status FROM cmdb_ci c JOIN cmdb_ci_hardware h ON c.sys_id = h.sys_id LIMIT 5")
        cmdb_nodes = [f"- Node {r[0]} ({r[1]} - Status: {r[2]})" for r in cur.fetchall()]
    except Exception:
        pass
    finally:
        conn.close()

    system_context = f"""You are Antigravity AI, the dedicated agentic coding & operations companion paired with Pilot James for Sovereign OS.
You are chatting with James directly on his mobile device (Pixel 10a) via the Antigravity Agent Bridge over Tailscale.

EMPIRICAL REAL-TIME CLIO STATE:
- Pilot: James (Enterprise ITSM Lead Architect, Father Joe Carroll Campsite Protocol).
- Primary Node: clio (Home base hub, Tailnet 100.73.155.70, SQLite sovereign_now.db in WAL mode).
- Recent Sovereign Tickets:
{chr(10).join(recent_tickets) if recent_tickets else 'No tickets active.'}
- Hardware CMDB Nodes:
{chr(10).join(cmdb_nodes) if cmdb_nodes else 'No hardware nodes registered.'}

STYLE RULES & INVARIANTS:
- Speak directly as Antigravity: sharp, supportive, highly competent, non-defensive.
- Provide actionable answers grounded in the real Sovereign OS architecture.
- Keep mobile responses punchy and structured."""

    reply_text = ""

    # 1. Primary Engine: Ultra-Fast Google Gemini REST API (gemini-3.5-flash-lite / gemini-3.6-flash)
    if gemini_key:
        models_to_try = ["gemini-3.5-flash-lite", "gemini-3.6-flash", "gemini-1.5-flash-latest"]
        for m_name in models_to_try:
            try:
                rest_url = f"https://generativelanguage.googleapis.com/v1beta/models/{m_name}:generateContent?key={gemini_key}"
                payload = {
                    "contents": [{
                        "parts": [{"text": f"{system_context}\n\nPilot James: {user_msg}\n\nAntigravity AI:"}]
                    }]
                }
                r_rest = requests.post(rest_url, json=payload, timeout=6)
                if r_rest.status_code == 200:
                    r_data = r_rest.json()
                    candidates = r_data.get("candidates", [])
                    if candidates and "content" in candidates[0]:
                        parts = candidates[0]["content"].get("parts", [])
                        if parts and "text" in parts[0]:
                            reply_text = parts[0]["text"].strip()
                            break
            except Exception as r_err:
                print(f"[REST_GEMINI_ERROR] {m_name}: {r_err}")
                continue

    # 2. Secondary Engine: Enterprise Vertex AI fallback
    if not reply_text:
        vertex_sa_path = "/home/james/SovereignOS/config/vertex_sa.json"
        if os.path.exists(vertex_sa_path):
            try:
                venv_site = "/home/james/SovereignOS/.venv/lib/python3.12/site-packages"
                if venv_site not in sys.path and os.path.exists(venv_site):
                    sys.path.insert(0, venv_site)
                os.environ["GOOGLE_APPLICATION_CREDENTIALS"] = vertex_sa_path
                import vertexai
                from vertexai.generative_models import GenerativeModel
                vertexai.init(project="gen-lang-client-0840454416", location="us-central1")
                v_model = GenerativeModel("gemini-3.5-flash-lite")
                prompt_payload = f"{system_context}\n\nPilot James: {user_msg}\n\nAntigravity AI:"
                v_resp = v_model.generate_content(prompt_payload)
                if v_resp and v_resp.text:
                    reply_text = v_resp.text.strip()
            except Exception as v_err:
                print(f"[VERTEX_AI_CHAT_ERROR] {v_err}")

    # 3. Tertiary Engine: Local Ollama (phi3:mini edge fallback with optimized prompt)
    if not reply_text:
        try:
            edge_prompt = f"You are Antigravity AI, the dedicated operations and coding companion for Pilot James on Sovereign OS. Answer concisely and supportively.\n\nPilot James: {user_msg}\n\nAntigravity AI:"
            r = requests.post("http://localhost:11434/api/generate", json={
                "model": "phi3:mini",
                "prompt": edge_prompt,
                "stream": False,
                "options": {"temperature": 0.7, "num_predict": 120}
            }, timeout=8)
            if r.status_code == 200:
                reply_text = r.json().get("response", "").strip()
        except Exception as o_err:
            print(f"[OLLAMA_CHAT_ERROR] {o_err}")

    # 4. Diagnostic Network Fallback (if all LLM backends fail)
    if not reply_text:
        reply_text = f"Antigravity radio online over Tailscale mesh, Pilot. (Notice: Cloud Vertex AI and local edge inference are currently unreachable). Transmission logged: '{user_msg}'"

    return {"reply": reply_text, "sender": "Antigravity AI", "timestamp": datetime.now().strftime("%H:%M:%S")}

@app.get("/api/all_personas")
def get_all_personas():
    """Returns all persona records from sovereign_now.db for advocate selection and setup."""
    conn = get_db()
    c = conn.cursor()
    try:
        c.execute("SELECT sys_id, user_name, display_name, team, deep_lore, avatar_url, visual_style, avatar_prompt FROM persona ORDER BY display_name ASC")
        rows = c.fetchall()
        personas = []
        for r in rows:
            personas.append({
                "sys_id": r["sys_id"] if isinstance(r, sqlite3.Row) else r[0],
                "user_name": r["user_name"] if isinstance(r, sqlite3.Row) else r[1],
                "display_name": (r["display_name"] or r["user_name"]) if isinstance(r, sqlite3.Row) else (r[2] or r[1]),
                "team": (r["team"] or "Smyrna Advocate") if isinstance(r, sqlite3.Row) else (r[3] or "Smyrna Advocate"),
                "deep_lore": (r["deep_lore"] or "") if isinstance(r, sqlite3.Row) else (r[4] or ""),
                "avatar_url": r["avatar_url"] if isinstance(r, sqlite3.Row) else r[5],
                "visual_style": (r["visual_style"] or "") if isinstance(r, sqlite3.Row) else (r[6] or ""),
                "avatar_prompt": (r["avatar_prompt"] or "") if isinstance(r, sqlite3.Row) else (r[7] or "")
            })
        return {"personas": personas, "count": len(personas)}
    finally:
        conn.close()

class PersonaUpdateRequest(BaseModel):
    user_name: str
    team: Optional[str] = None
    system_prompt: Optional[str] = None
    deep_lore: Optional[str] = None
    governance: Optional[str] = None
    behavior_notes: Optional[str] = None
    boggs_level: Optional[int] = None
    color: Optional[str] = None
    cadence: Optional[str] = None
    avatar_url: Optional[str] = None

@app.post("/api/persona/update")
def update_persona_endpoint(req: PersonaUpdateRequest):
    """Update persona profile fields in sovereign_now.db."""
    conn = get_db()
    c = conn.cursor()
    try:
        fields = []
        vals = []
        if req.team is not None:
            fields.append("team = ?")
            vals.append(req.team)
        if req.system_prompt is not None:
            fields.append("system_prompt = ?")
            vals.append(req.system_prompt)
        if req.deep_lore is not None:
            fields.append("deep_lore = ?")
            vals.append(req.deep_lore)
        if req.governance is not None:
            fields.append("governance = ?")
            vals.append(req.governance)
        if req.behavior_notes is not None:
            fields.append("behavior_notes = ?")
            vals.append(req.behavior_notes)
        if req.boggs_level is not None:
            fields.append("boggs_level = ?")
            vals.append(req.boggs_level)
        if req.color is not None:
            fields.append("color = ?")
            vals.append(req.color)
        if req.cadence is not None:
            fields.append("cadence = ?")
            vals.append(req.cadence)
        if req.avatar_url is not None:
            fields.append("avatar_url = ?")
            vals.append(req.avatar_url)
        
        fields.append("updated_at = datetime('now')")
        vals.append(req.user_name)
        vals.append(req.user_name)
        
        sql = f"UPDATE persona SET {', '.join(fields)} WHERE user_name = ? OR id = ?"
        c.execute(sql, tuple(vals))
        conn.commit()
        return {"status": "SUCCESS", "user_name": req.user_name, "updated_fields": [f.split(" =")[0] for f in fields[:-1]]}
    finally:
        conn.close()

@app.get("/api/persona/{user_name}")
def get_persona_endpoint(user_name: str):
    """Retrieve full persona profile from sovereign_now.db."""
    conn = get_db()
    c = conn.cursor()
    try:
        c.execute("SELECT sys_id, user_name, display_name, team, system_prompt, deep_lore, governance, behavior_notes, boggs_level, color, cadence, avatar_url FROM persona WHERE user_name = ? OR id = ?", (user_name, user_name))
        row = c.fetchone()
        if not row:
            return JSONResponse({"status": "error", "message": f"Persona @{user_name} not found"}, status_code=404)
        return {
            "status": "SUCCESS",
            "persona": {
                "sys_id": row[0],
                "user_name": row[1],
                "display_name": row[2],
                "team": row[3],
                "system_prompt": row[4],
                "deep_lore": row[5],
                "governance": row[6],
                "behavior_notes": row[7],
                "boggs_level": row[8],
                "color": row[9],
                "cadence": row[10],
                "avatar_url": row[11]
            }
        }
    finally:
        conn.close()

@app.post("/api/persona/ledger/purge_corrupt")
def purge_corrupt_ledger_endpoint(persona_id: str, game_pk: str):
    """Purges corrupted short fragments for a persona (or all personas) in a game room."""
    conn = get_db()
    c = conn.cursor()
    try:
        corrupt_filter = """
            (
                length(trim(comment_text)) <= 8 
                OR instr(trim(comment_text), ' ') = 0
                OR comment_text IN ('Manaea', 'Sem', 'I’m', 'I''m', 'James', 'Technical pur', 'Semien got way out')
                OR comment_text LIKE '%Ghost Trauma%'
                OR comment_text LIKE '%:**%'
                OR comment_text LIKE '%rotate topics%'
                OR comment_text LIKE '%**'
                OR comment_text LIKE '###%'
            )
        """
        if persona_id.lower() in ("all", "*"):
            c.execute(f"""
                DELETE FROM m2m_persona_room_ledger 
                WHERE (game_pk = ? OR game_pk = CAST(? AS INTEGER))
                  AND {corrupt_filter}
            """, (str(game_pk), str(game_pk)))
        else:
            c.execute(f"""
                DELETE FROM m2m_persona_room_ledger 
                WHERE (persona_id = ? OR persona_id = ?)
                  AND (game_pk = ? OR game_pk = CAST(? AS INTEGER))
                  AND {corrupt_filter}
            """, (persona_id, persona_id.lower(), str(game_pk), str(game_pk)))
        deleted = c.rowcount
        conn.commit()
        return {"status": "SUCCESS", "persona_id": persona_id, "game_pk": game_pk, "deleted_rows": deleted}
    finally:
        conn.close()

class DeriveToonRequest(BaseModel):
    user_name: str

@app.post("/api/ttrpg/derive_toon")
async def derive_ttrpg_toon(req: DeriveToonRequest):
    """Derives a grounded D&D character sheet from an advocate's real-life bio."""
    conn = get_db()
    c = conn.cursor()
    try:
        c.execute("SELECT display_name, team, deep_lore, avatar_prompt FROM persona WHERE user_name = ?", (req.user_name,))
        row = c.fetchone()
        if not row:
            return JSONResponse({"status": "error", "message": f"Persona @{req.user_name} not found"}, status_code=404)
        
        display_name, team, deep_lore, avatar_prompt = row[0], row[1], row[2], row[3]
        
        alter_ego = f"{display_name}"
        dnd_class = "Smyrna Advocate"
        
        lower_lore = ((deep_lore or "") + " " + (display_name or "")).lower()
        if "rune" in lower_lore or "goliath" in lower_lore or "twin-soul" in lower_lore or "cooper" in req.user_name:
            alter_ego = f"{display_name} (Twin-Soul Warden)"
            dnd_class = "Goliath Rune Knight Fighter"
        elif "chrono" in lower_lore or "gwen" in req.user_name or "time" in lower_lore:
            alter_ego = f"GWEN THE CHRONO-ARCHITECT"
            dnd_class = "Arcane Chronurgy Navigator"
        elif "cat" in lower_lore or "greta" in req.user_name:
            alter_ego = f"{display_name}"
            dnd_class = "Shadowcat Arcane Rogue"
        elif "clerk" in lower_lore or "bob" in req.user_name:
            alter_ego = f"{display_name}"
            dnd_class = "Stop-and-Go Elder Clerk / Warlock"
        elif "dr" in lower_lore or "roxy" in req.user_name or "vet" in lower_lore:
            alter_ego = f"{display_name}"
            dnd_class = "Systems Healer / Cleric of Life"
        elif "barf" in req.user_name:
            alter_ego = f"{display_name}"
            dnd_class = "Smyrna Foodie / Forge Cleric"
        elif "barb" in req.user_name:
            alter_ego = f"{display_name}"
            dnd_class = "Smyrna Founder / Paladin of Devotion"
        
        char_id = f"ttrpg_sheet_{req.user_name}"
        
        c.execute("""
            INSERT INTO ttrpg_character_sheet (character_id, user_name, dnd_alter_ego, dnd_class, level, hp_current, hp_max, armor_class, spell_slots_json)
            VALUES (?, ?, ?, ?, 8, 50, 50, 16, '[4, 3, 2, 0]')
            ON CONFLICT(user_name) DO UPDATE SET
                dnd_alter_ego = excluded.dnd_alter_ego,
                dnd_class = excluded.dnd_class,
                updated_at = datetime('now')
        """, (char_id, req.user_name, alter_ego, dnd_class))
        conn.commit()
        
        return {
            "status": "success",
            "derived_toon": {
                "user_name": req.user_name,
                "display_name": display_name,
                "dnd_alter_ego": alter_ego,
                "dnd_class": dnd_class,
                "level": 8
            }
        }
    finally:
        conn.close()


# ── CMDB STUDIO & CI RELATIONSHIP MANAGEMENT API ────────────

@app.get("/api/cmdb/stats")
def get_cmdb_stats():
    conn = get_db()
    c = conn.cursor()
    try:
        c.execute("SELECT COUNT(*) FROM cmdb_ci")
        total_cis = c.fetchone()[0]

        c.execute("SELECT COUNT(*) FROM cmdb_rel_ci")
        total_rels = c.fetchone()[0]

        c.execute("SELECT sys_class_name, COUNT(*) FROM cmdb_ci GROUP BY sys_class_name ORDER BY COUNT(*) DESC")
        class_breakdown = [{"class": r[0], "count": r[1]} for r in c.fetchall()]

        c.execute("SELECT operational_status, COUNT(*) FROM cmdb_ci GROUP BY operational_status")
        status_breakdown = [{"status": r[0] or 1, "count": r[1]} for r in c.fetchall()]

        return {
            "total_cis": total_cis,
            "total_relationships": total_rels,
            "class_breakdown": class_breakdown,
            "status_breakdown": status_breakdown,
            "health_score": "98.4%",
            "timestamp": datetime.now().isoformat()
        }
    finally:
        conn.close()

@app.get("/api/cmdb/probe")
@app.post("/api/cmdb/probe")
async def probe_cmdb_fleet():
    conn = get_db()
    c = conn.cursor()
    probed_count = 0
    healthy = 0
    outages = 0
    now_iso = datetime.now().isoformat()

    try:
        # 1. Query all cmdb_ci_edge_endpoint rows & probe HTTP HEAD
        c.execute("SELECT sys_id, public_url, health_check_path FROM cmdb_ci_edge_endpoint")
        edge_rows = c.fetchall()

        for row in edge_rows:
            sys_id = row["sys_id"]
            public_url = row["public_url"] or ""
            health_path = row["health_check_path"] or "/"
            if not health_path.startswith("/"):
                health_path = "/" + health_path
            target_url = public_url.rstrip("/") + health_path

            last_status = 0
            op_status = 4
            try:
                async with httpx.AsyncClient(verify=False) as client:
                    try:
                        resp = await client.head(target_url, timeout=2.5, follow_redirects=True)
                        last_status = resp.status_code
                        if 200 <= last_status < 400:
                            op_status = 1
                        elif last_status == 405:
                            get_resp = await client.get(target_url, timeout=2.5, follow_redirects=True)
                            last_status = get_resp.status_code
                            op_status = 1 if 200 <= last_status < 400 else 4
                        else:
                            op_status = 4
                    except Exception:
                        try:
                            get_resp = await client.get(target_url, timeout=2.5, follow_redirects=True)
                            last_status = get_resp.status_code
                            op_status = 1 if 200 <= last_status < 400 else 4
                        except Exception:
                            last_status = 0
                            op_status = 4
            except Exception:
                last_status = 0
                op_status = 4

            c.execute(
                "UPDATE cmdb_ci_edge_endpoint SET last_http_status = ?, last_probe_time = ? WHERE sys_id = ?",
                (last_status, now_iso, sys_id)
            )
            c.execute(
                "UPDATE cmdb_ci SET operational_status = ?, sys_updated_on = ? WHERE sys_id = ?",
                (op_status, now_iso, sys_id)
            )

            probed_count += 1
            if op_status == 1:
                healthy += 1
            else:
                outages += 1

        # 2. For cmdb_ci_appl rows with a detected port, perform 250ms TCP socket connect probe
        c.execute("""
            SELECT c.sys_id, c.name, a.port, c.short_description
            FROM cmdb_ci c
            LEFT JOIN cmdb_ci_appl a ON c.sys_id = a.sys_id
            WHERE c.sys_class_name = 'cmdb_ci_appl'
        """)
        appl_rows = c.fetchall()

        for row in appl_rows:
            sys_id = row["sys_id"]
            name = row["name"] or ""
            port_val = row["port"]
            desc = row["short_description"] or ""

            detected_port = None
            if port_val is not None:
                try:
                    p = int(str(port_val).strip())
                    if 1 <= p <= 65535:
                        detected_port = p
                except ValueError:
                    pass

            if not detected_port:
                m = re.search(r'\b[Pp]ort\s*[:=]?\s*(\d{2,5})\b', f"{desc} {name}")
                if m:
                    try:
                        p = int(m.group(1))
                        if 1 <= p <= 65535:
                            detected_port = p
                    except ValueError:
                        pass

            if detected_port:
                sock_ok = False
                try:
                    with socket.create_connection(("127.0.0.1", detected_port), timeout=0.25):
                        sock_ok = True
                except Exception:
                    sock_ok = False

                appl_op_status = 1 if sock_ok else 4
                c.execute(
                    "UPDATE cmdb_ci SET operational_status = ?, sys_updated_on = ? WHERE sys_id = ?",
                    (appl_op_status, now_iso, sys_id)
                )

                probed_count += 1
                if appl_op_status == 1:
                    healthy += 1
                else:
                    outages += 1

        conn.commit()

        return {
            "probed_count": probed_count,
            "healthy": healthy,
            "outages": outages,
            "timestamp": now_iso
        }
    finally:
        conn.close()

@app.get("/api/cmdb/cis")
def get_cmdb_cis(sys_class_name: Optional[str] = None, operational_status: Optional[int] = None, search: Optional[str] = None, limit: int = 200, offset: int = 0):
    conn = get_db()
    c = conn.cursor()
    try:
        query = """
            SELECT 
                ci.sys_id, ci.name, ci.sys_class_name, ci.short_description, 
                ci.operational_status, ci.assigned_to, ci.sys_created_on, ci.sys_updated_on,
                (SELECT COUNT(*) FROM cmdb_rel_ci WHERE child = ci.sys_id) as upstream_count,
                (SELECT COUNT(*) FROM cmdb_rel_ci WHERE parent = ci.sys_id) as downstream_count,
                h.ip_address, h.model_id,
                e.public_url, e.upstream_port
            FROM cmdb_ci ci
            LEFT JOIN cmdb_ci_hardware h ON ci.sys_id = h.sys_id
            LEFT JOIN cmdb_ci_edge_endpoint e ON ci.sys_id = e.sys_id
            WHERE 1=1
        """
        params = []
        if sys_class_name and sys_class_name != "all":
            query += " AND ci.sys_class_name = ?"
            params.append(sys_class_name)
        if operational_status:
            query += " AND ci.operational_status = ?"
            params.append(operational_status)
        if search:
            query += " AND (ci.name LIKE ? OR ci.short_description LIKE ? OR ci.sys_class_name LIKE ? OR h.ip_address LIKE ? OR e.public_url LIKE ?)"
            s_param = f"%{search}%"
            params.extend([s_param, s_param, s_param, s_param, s_param])

        query += " ORDER BY ci.operational_status ASC, ci.name ASC LIMIT ? OFFSET ?"
        params.extend([limit, offset])

        c.execute(query, params)
        rows = c.fetchall()

        cis = []
        for r in rows:
            cis.append({
                "sys_id": r[0],
                "name": r[1],
                "sys_class_name": r[2],
                "short_description": r[3] or "",
                "operational_status": r[4] if r[4] is not None else 1,
                "assigned_to": r[5] or "Unassigned",
                "sys_created_on": r[6],
                "sys_updated_on": r[7],
                "upstream_count": r[8],
                "downstream_count": r[9],
                "ip_address": r[10] or "",
                "model_id": r[11] or "",
                "public_url": r[12] or "",
                "upstream_port": r[13] or ""
            })

        return {"cis": cis, "count": len(cis), "limit": limit, "offset": offset}
    finally:
        conn.close()

@app.get("/api/cmdb/topology")
def get_cmdb_topology(class_filter: Optional[str] = None):
    conn = get_db()
    c = conn.cursor()
    try:
        # 1. Fetch relationships
        c.execute("""
            SELECT r.sys_id, r.parent, r.child, r.type,
                   p.name as parent_name, p.sys_class_name as parent_class, p.operational_status as parent_status,
                   ch.name as child_name, ch.sys_class_name as child_class, ch.operational_status as child_status
            FROM cmdb_rel_ci r
            JOIN cmdb_ci p ON r.parent = p.sys_id
            JOIN cmdb_ci ch ON r.child = ch.sys_id
        """)
        rel_rows = c.fetchall()

        nodes_dict = {}
        edges = []

        for r in rel_rows:
            rel_id, parent_id, child_id, rel_type, p_name, p_class, p_status, ch_name, ch_class, ch_status = r

            # Parent node
            if parent_id not in nodes_dict:
                nodes_dict[parent_id] = {
                    "id": parent_id,
                    "name": p_name,
                    "class": p_class,
                    "status": p_status if p_status is not None else 1,
                    "upstream_count": 0,
                    "downstream_count": 0
                }
            nodes_dict[parent_id]["downstream_count"] += 1

            # Child node
            if child_id not in nodes_dict:
                nodes_dict[child_id] = {
                    "id": child_id,
                    "name": ch_name,
                    "class": ch_class,
                    "status": ch_status if ch_status is not None else 1,
                    "upstream_count": 0,
                    "downstream_count": 0
                }
            nodes_dict[child_id]["upstream_count"] += 1

            edges.append({
                "id": rel_id,
                "source": parent_id,
                "target": child_id,
                "type": rel_type or "Depends on::Used by",
                "source_name": p_name,
                "target_name": ch_name
            })

        # Also include key hardware and application CIs if they have no explicit relationships yet
        c.execute("""
            SELECT sys_id, name, sys_class_name, operational_status
            FROM cmdb_ci 
            WHERE sys_class_name IN ('cmdb_ci_hardware', 'cmdb_ci_stack', 'cmdb_ci_feline_operative', 'cmdb_ci_cognitive_core')
        """)
        for r in c.fetchall():
            ci_id, name, class_name, status = r
            if ci_id not in nodes_dict:
                nodes_dict[ci_id] = {
                    "id": ci_id,
                    "name": name,
                    "class": class_name,
                    "status": status if status is not None else 1,
                    "upstream_count": 0,
                    "downstream_count": 0
                }

        return {
            "nodes": list(nodes_dict.values()),
            "edges": edges,
            "node_count": len(nodes_dict),
            "edge_count": len(edges)
        }
    finally:
        conn.close()

@app.get("/api/cmdb/ci/{sys_id}")
def get_cmdb_ci_detail(sys_id: str):
    conn = get_db()
    c = conn.cursor()
    try:
        c.execute("""
            SELECT ci.sys_id, ci.name, ci.sys_class_name, ci.short_description, 
                   ci.operational_status, ci.assigned_to, ci.sys_created_on, ci.sys_updated_on,
                   h.ip_address, h.model_id, h.mac_address
            FROM cmdb_ci ci
            LEFT JOIN cmdb_ci_hardware h ON ci.sys_id = h.sys_id
            WHERE ci.sys_id = ? OR ci.name = ?
        """, (sys_id, sys_id))
        row = c.fetchone()
        if not row:
            raise HTTPException(status_code=404, detail="Configuration Item not found")

        resolved_sys_id = row[0]

        ci_data = {
            "sys_id": row[0],
            "name": row[1],
            "sys_class_name": row[2],
            "short_description": row[3] or "",
            "operational_status": row[4] if row[4] is not None else 1,
            "assigned_to": row[5] or "Unassigned",
            "sys_created_on": row[6],
            "sys_updated_on": row[7],
            "hardware": {
                "ip_address": row[8] or "",
                "model_id": row[9] or "",
                "mac_address": row[10] or "",
                "cpu_count": "",
                "ram_mb": "",
                "os_version": ""
            }
        }

        # Upstream Parents (where this CI is the child)
        c.execute("""
            SELECT r.sys_id, r.parent, r.type, p.name, p.sys_class_name, p.operational_status
            FROM cmdb_rel_ci r
            JOIN cmdb_ci p ON r.parent = p.sys_id
            WHERE r.child = ?
        """, (resolved_sys_id,))
        ci_data["upstream_parents"] = [
            {"rel_id": r[0], "parent_id": r[1], "type": r[2], "name": r[3], "class": r[4], "status": r[5]}
            for r in c.fetchall()
        ]

        # Downstream Children (where this CI is the parent)
        c.execute("""
            SELECT r.sys_id, r.child, r.type, ch.name, ch.sys_class_name, ch.operational_status
            FROM cmdb_rel_ci r
            JOIN cmdb_ci ch ON r.child = ch.sys_id
            WHERE r.parent = ?
        """, (resolved_sys_id,))
        ci_data["downstream_children"] = [
            {"rel_id": r[0], "child_id": r[1], "type": r[2], "name": r[3], "class": r[4], "status": r[5]}
            for r in c.fetchall()
        ]

        return ci_data
    finally:
        conn.close()

class CIRequest(BaseModel):
    name: str
    sys_class_name: str
    short_description: Optional[str] = ""
    operational_status: Optional[int] = 1
    assigned_to: Optional[str] = "james"
    ip_address: Optional[str] = None
    model_id: Optional[str] = None

@app.post("/api/cmdb/ci")
def create_cmdb_ci(req: CIRequest):
    conn = get_db()
    c = conn.cursor()
    sys_id = f"ci_{uuid.uuid4().hex[:12]}"
    try:
        c.execute("""
            INSERT INTO cmdb_ci (sys_id, name, sys_class_name, short_description, operational_status, assigned_to, sys_created_on, sys_updated_on)
            VALUES (?, ?, ?, ?, ?, ?, datetime('now'), datetime('now'))
        """, (sys_id, req.name, req.sys_class_name, req.short_description, req.operational_status, req.assigned_to))

        if req.sys_class_name == "cmdb_ci_hardware" or req.ip_address:
            c.execute("""
                INSERT OR REPLACE INTO cmdb_ci_hardware (sys_id, ip_address, model_id, sys_created_on, sys_updated_on)
                VALUES (?, ?, ?, datetime('now'), datetime('now'))
            """, (sys_id, req.ip_address, req.model_id))

        conn.commit()
        return {"status": "success", "sys_id": sys_id, "message": f"CI '{req.name}' created successfully."}
    finally:
        conn.close()

@app.put("/api/cmdb/ci/{sys_id}")
def update_cmdb_ci(sys_id: str, req: CIRequest):
    conn = get_db()
    c = conn.cursor()
    try:
        c.execute("""
            UPDATE cmdb_ci 
            SET name = ?, sys_class_name = ?, short_description = ?, operational_status = ?, assigned_to = ?, sys_updated_on = datetime('now')
            WHERE sys_id = ?
        """, (req.name, req.sys_class_name, req.short_description, req.operational_status, req.assigned_to, sys_id))

        if req.ip_address or req.model_id:
            c.execute("""
                INSERT OR REPLACE INTO cmdb_ci_hardware (sys_id, ip_address, model_id, sys_updated_on)
                VALUES (?, ?, ?, datetime('now'))
            """, (sys_id, req.ip_address, req.model_id))

        conn.commit()
        return {"status": "success", "sys_id": sys_id, "message": f"CI '{req.name}' updated successfully."}
    finally:
        conn.close()

@app.delete("/api/cmdb/ci/{sys_id}")
def delete_cmdb_ci(sys_id: str):
    conn = get_db()
    c = conn.cursor()
    try:
        c.execute("SELECT name FROM cmdb_ci WHERE sys_id = ?", (sys_id,))
        row = c.fetchone()
        if not row:
            raise HTTPException(status_code=404, detail="CI not found")
        ci_name = row[0]
        c.execute("DELETE FROM cmdb_rel_ci WHERE parent = ? OR child = ?", (sys_id, sys_id))
        c.execute("DELETE FROM cmdb_ci_hardware WHERE sys_id = ?", (sys_id,))
        c.execute("DELETE FROM cmdb_ci_appl WHERE sys_id = ?", (sys_id,))
        c.execute("DELETE FROM cmdb_ci_edge_endpoint WHERE sys_id = ?", (sys_id,))
        c.execute("DELETE FROM cmdb_ci WHERE sys_id = ?", (sys_id,))
        conn.commit()
        return {"status": "success", "message": f"CI '{ci_name}' ({sys_id}) decommissioned and deleted."}
    finally:
        conn.close()

class RelationshipRequest(BaseModel):
    parent: str
    child: str
    type: str

@app.post("/api/cmdb/relationships")
def create_cmdb_relationship(req: RelationshipRequest):
    conn = get_db()
    c = conn.cursor()
    sys_id = uuid.uuid4().hex
    try:
        # Check both exist
        c.execute("SELECT name FROM cmdb_ci WHERE sys_id = ?", (req.parent,))
        p_row = c.fetchone()
        c.execute("SELECT name FROM cmdb_ci WHERE sys_id = ?", (req.child,))
        ch_row = c.fetchone()

        if not p_row or not ch_row:
            raise HTTPException(status_code=400, detail="Parent or Child CI does not exist.")

        c.execute("""
            INSERT INTO cmdb_rel_ci (sys_id, parent, child, type, sys_created_on, sys_updated_on)
            VALUES (?, ?, ?, ?, datetime('now'), datetime('now'))
        """, (sys_id, req.parent, req.child, req.type))

        conn.commit()
        return {
            "status": "success",
            "sys_id": sys_id,
            "message": f"Relationship '{p_row[0]}' --[{req.type}]--> '{ch_row[0]}' established."
        }
    finally:
        conn.close()

@app.delete("/api/cmdb/relationships/{sys_id}")
def delete_cmdb_relationship(sys_id: str):
    conn = get_db()
    c = conn.cursor()
    try:
        c.execute("DELETE FROM cmdb_rel_ci WHERE sys_id = ?", (sys_id,))
        conn.commit()
        return {"status": "success", "message": f"Relationship {sys_id} removed."}
    finally:
        conn.close()

@app.get("/api/cmdb/impact/{sys_id}")
def get_cmdb_impact_analysis(sys_id: str):
    """Calculates recursive downstream blast radius impact if this CI fails."""
    conn = get_db()
    c = conn.cursor()
    try:
        c.execute("SELECT sys_id, name, sys_class_name, operational_status FROM cmdb_ci WHERE sys_id = ?", (sys_id,))
        target_ci = c.fetchone()
        if not target_ci:
            raise HTTPException(status_code=404, detail="Target CI not found.")

        # Recursive BFS traversal of downstream dependencies
        impacted_nodes = []
        visited = set([sys_id])
        queue = [(sys_id, 0)] # (ci_id, depth)

        while queue:
            curr_id, depth = queue.pop(0)
            c.execute("""
                SELECT r.child, ch.name, ch.sys_class_name, r.type, ch.operational_status
                FROM cmdb_rel_ci r
                JOIN cmdb_ci ch ON r.child = ch.sys_id
                WHERE r.parent = ?
            """, (curr_id,))
            children = c.fetchall()

            for ch_id, ch_name, ch_class, rel_type, ch_status in children:
                if ch_id not in visited:
                    visited.add(ch_id)
                    impacted_nodes.append({
                        "id": ch_id,
                        "name": ch_name,
                        "class": ch_class,
                        "rel_type": rel_type,
                        "depth": depth + 1,
                        "status": ch_status if ch_status is not None else 1
                    })
                    queue.append((ch_id, depth + 1))

        # Severity determination
        impact_count = len(impacted_nodes)
        if impact_count > 10 or "hardware" in (target_ci[2] or "").lower():
            severity = "CRITICAL (SEV-1)"
        elif impact_count > 3:
            severity = "HIGH (SEV-2)"
        elif impact_count > 0:
            severity = "MODERATE (SEV-3)"
        else:
            severity = "ISOLATED (SEV-4)"

        return {
            "target_ci": {
                "id": target_ci[0],
                "name": target_ci[1],
                "class": target_ci[2],
                "status": target_ci[3]
            },
            "severity": severity,
            "blast_radius_count": impact_count,
            "impacted_nodes": impacted_nodes,
            "analysis_timestamp": datetime.now().isoformat()
        }
    finally:
        conn.close()

# ── TTRPG DUAL-LAYER ADVOCATE & STAGING ENDPOINTS ───────────────

class TTRPGAdvocateUpdateRequest(BaseModel):
    user_name: str
    dnd_alter_ego: str
    dnd_class: str
    level: int
    spell_slots: list[int]
    boggs_level: int
    system_prompt: str

class TTRPGRoomStageRequest(BaseModel):
    room_id: str
    advocates: list[str]


@app.get("/api/ttrpg/advocates")
def get_ttrpg_advocates(room_id: Optional[str] = None):
    """Returns the tabletop advocate personas with real-life vs D&D alter-ego metadata directly from ttrpg_character_sheet, persona, and m2m_persona_room tables."""
    conn = get_db()
    c = conn.cursor()
    try:
        if room_id:
            c.execute("""
                SELECT 
                    t.user_name,
                    COALESCE(p.display_name, t.user_name) as display_name,
                    COALESCE(p.behavior_notes, 'Sovereign Advocate') as real_life_title,
                    t.dnd_alter_ego,
                    t.dnd_class,
                    t.level,
                    COALESCE(p.boggs_level, 3) as boggs_level,
                    CASE WHEN t.user_name = 'so_gwen' THEN 'Web UI Qwen Guest' ELSE 'Unified Gemini Engine' END as llm_engine,
                    COALESCE(p.system_prompt, 'Sovereign TTRPG Advocate') as system_prompt,
                    COALESCE(p.avatar_url, '') as avatar_real,
                    COALESCE((SELECT file_path FROM cmdb_ci_media_asset WHERE advocate = t.user_name AND expression = 'DND_WILD_TOON' LIMIT 1), p.avatar_url, '') as avatar_dnd
                FROM m2m_persona_room m
                JOIN ttrpg_character_sheet t ON m.persona = t.user_name
                LEFT JOIN persona p ON t.user_name = p.user_name
                WHERE m.room = ? AND t.dnd_alter_ego NOT LIKE '%Pending%'
            """, (room_id,))
        else:
            c.execute("""
                SELECT 
                    t.user_name,
                    COALESCE(p.display_name, t.user_name) as display_name,
                    COALESCE(p.behavior_notes, 'Sovereign Advocate') as real_life_title,
                    t.dnd_alter_ego,
                    t.dnd_class,
                    t.level,
                    COALESCE(p.boggs_level, 3) as boggs_level,
                    CASE WHEN t.user_name = 'so_gwen' THEN 'Web UI Qwen Guest' ELSE 'Unified Gemini Engine' END as llm_engine,
                    COALESCE(p.system_prompt, 'Sovereign TTRPG Advocate') as system_prompt,
                    COALESCE(p.avatar_url, '') as avatar_real,
                    COALESCE((SELECT file_path FROM cmdb_ci_media_asset WHERE advocate = t.user_name AND expression = 'DND_WILD_TOON' LIMIT 1), p.avatar_url, '') as avatar_dnd
                FROM ttrpg_character_sheet t
                LEFT JOIN persona p ON t.user_name = p.user_name
                WHERE t.dnd_alter_ego NOT LIKE '%Pending%'
            """)
        rows = c.fetchall()
        advocates = []
        for r in rows:
            advocates.append({
                "user_name": r[0],
                "display_name": r[1],
                "real_life_title": r[2],
                "dnd_alter_ego": r[3],
                "dnd_class": r[4],
                "level": r[5],
                "spell_slots": [1, 2, 3, 4],
                "boggs_level": r[6],
                "llm_engine": r[7],
                "system_prompt": r[8],
                "avatar_real": r[9],
                "avatar_dnd": r[10]
            })

        return {"status": "SUCCESS", "room_id": room_id, "count": len(advocates), "advocates": advocates}
    finally:
        conn.close()

@app.post("/api/ttrpg/advocates/update")
def update_ttrpg_advocate(req: TTRPGAdvocateUpdateRequest):
    """Updates dual-layer advocate settings in persona table in sovereign_now.db."""
    conn = get_db()
