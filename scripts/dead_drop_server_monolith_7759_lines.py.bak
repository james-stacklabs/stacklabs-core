  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toast-container" class="fixed bottom-4 right-4 flex flex-col gap-2 z-50 pointer-events-none"></div>
  <script>
    // Tab switching (both desktop and mobile pills)
    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      const activeContent = document.getElementById(tabId);
      if (activeContent) activeContent.classList.remove('hidden');
      const base = tabId.replace('tab-', '');
      const activeBtn = document.getElementById('btn-' + base);
      if (activeBtn) activeBtn.classList.add('active');
      const mActiveBtn = document.getElementById('m-btn-' + base);
      if (mActiveBtn) mActiveBtn.classList.add('active');
      if (tabId === 'tab-cmdb') {
        loadCmdbLite();
      }
      if (tabId === 'tab-predict') {
        loadPredictMarket();
      }
    }
    // Toast manager
    function showToast(message, isError = false) {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = 'px-3 py-2 rounded-[2px] text-xs font-semibold shadow-lg transition-all duration-300 transform translate-y-2 opacity-0 flex items-center gap-2 border ' + 
        (isError ? 'bg-red-950 text-red-200 border-red-800/60' : 'bg-[#151D2C] text-emerald-300 border-[#2A3447]');
      toast.innerHTML = `<span>${isError ? '⚠️' : '✓'}</span><span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 10);
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }
    // Safe string escape
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
    // Audio recorder thumb zone toggle
    let isRecording = false;
    function toggleAudioRecord() {
      const btn = document.getElementById('mic-btn');
      const label = document.getElementById('mic-status-label');
      if (!isRecording) {
        isRecording = true;
        btn.classList.add('animate-pulse', 'ring-4', 'ring-red-500/50');
        label.textContent = 'Listening... Speak Pilot Drop';
        showToast('🎙️ Audio ingress activated. Tap again to commit drop.');
      } else {
        isRecording = false;
        btn.classList.remove('animate-pulse', 'ring-4', 'ring-red-500/50');
        label.textContent = 'Tap to Dictate Pilot Drop';
        showToast('✓ Audio drop staged and committed to scratch pad');
      }
    }
    // Quick text drops
    async function submitMissionQuickDrop() {
      const input = document.getElementById('mission-quick-drop-input');
      const text = input.value.trim();
      if (!text) return;
      await postQuickDrop(text);
      input.value = '';
    }
    async function submitDedicatedDrop() {
      const textarea = document.getElementById('dedicated-drop-input');
      const text = textarea.value.trim();
      if (!text) return;
      await postQuickDrop(text);
      textarea.value = '';
    }
    async function postQuickDrop(text) {
      try {
        const res = await fetch('/api/cockpit/quickdrop', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: text })
        });
        const data = await res.json();
        if (res.ok) {
          showToast('✓ Staged to scratch_pad.md');
          fetchDrops();
        } else {
          showToast('Drop failed: ' + (data.message || 'Error'), true);
        }
      } catch (err) {
        showToast('Drop failed: ' + err.message, true);
      }
    }
    const fetchQueue = fetchQueueTelemetry;
    async function submitWorkOrderStage() {
      const contentEl = document.getElementById('stage-wo-content');
      const titleEl = document.getElementById('stage-wo-title');
      const btn = document.getElementById('btn-stage-wo');
      const content = contentEl.value.trim();
      const title = titleEl ? titleEl.value.trim() : '';
      if (!content) {
        showToast('Work order markdown cannot be empty', true);
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Staging to metal...';
      try {
        const res = await fetch('/api/cockpit/stage_work_order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: content, title: title })
        });
        const data = await res.json();
        if (res.ok && data.status === 'success') {
          showToast(`✓ Staged ${data.ticket_id} to queue/incoming/`);
          contentEl.value = '';
          if (titleEl) titleEl.value = '';
          if (typeof fetchQueueTelemetry === 'function') fetchQueueTelemetry();
          if (typeof fetchQueue === 'function') fetchQueue();
        } else {
          showToast('Staging failed: ' + (data.message || 'Server error'), true);
        }
      } catch (err) {
        showToast('Network error staging work order: ' + err.message, true);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Stage to Metal (queue/incoming/) 🚀';
      }
    }
    async function handleWoDocumentUpload(e) {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      await parseWoDocumentFile(file);
      e.target.value = '';
    }
    async function parseWoDocumentFile(file) {
      const contentEl = document.getElementById('stage-wo-content');
      const titleEl = document.getElementById('stage-wo-title');
      showToast(`Extracting ${file.name}...`);
      try {
        let extracted = '';
        const ext = file.name.split('.').pop().toLowerCase();
        if (ext === 'pdf' || file.type === 'application/pdf') {
          if (typeof pdfjsLib === 'undefined') {
            throw new Error('PDF parsing library loading... please retry in a moment');
          }
          const arrayBuffer = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
          const pages = [];
          for (let i = 1; i <= pdf.numPages; i++) {
            const page = await pdf.getPage(i);
            const textContent = await page.getTextContent();
            const pageText = textContent.items.map(item => item.str).join(' ');
            pages.push(pageText);
          }
          extracted = pages.join('\n\n');
        } else {
          extracted = await file.text();
        }
        if (!extracted.trim()) {
          showToast(`Warning: No readable text found in ${file.name}`, true);
          return;
        }
        contentEl.value = extracted;
        if (titleEl && !titleEl.value.trim()) {
          const matchTitle = extracted.match(/(?:#\s*WORK\s*ORDER:\s*|#\s*TICKET:\s*|\*\*Title:\*\*\s*)([^\n]+)/i);
          if (matchTitle) {
            titleEl.value = matchTitle[1].replace(/[*_#]/g, '').trim();
          } else {
            titleEl.value = file.name.replace(/\.[^/.]+$/, '').replace(/[^a-zA-Z0-9_\-]/g, '-').toUpperCase();
          }
        }
        const words = extracted.trim().split(/\s+/).length;
        showToast(`✓ Extracted ${words} words from ${file.name}`);
      } catch (err) {
        showToast(`Extraction failed: ${err.message}`, true);
      }
    }
    // File upload
    async function handleFileUpload(e) {
      const files = e.target.files;
      if (!files || files.length === 0) return;
      for (const file of files) {
        const fd = new FormData();
        fd.append('file', file);
        try {
          const res = await fetch('/api/upload', { method: 'POST', body: fd });
          const data = await res.json();
          if (res.ok) {
            showToast(`Uploaded: ${file.name}`);
          } else {
            showToast(`Upload failed: ${data.error || 'Error'}`, true);
          }
        } catch (err) {
          showToast(`Upload error: ${err.message}`, true);
        }
      }
      fetchDrops();
    }
    // Fetch drops list
    async function fetchDrops() {
      try {
        const res = await fetch('/api/drops');
        if (!res.ok) return;
        const data = await res.json();
        const files = data.files || [];
        const pillCount = document.getElementById('pill-drop-count');
        const mPillCount = document.getElementById('m-pill-drop-count');
        const statDrops = document.getElementById('stat-drops-val');
        if (pillCount) pillCount.textContent = files.length || '0';
        if (mPillCount) mPillCount.textContent = files.length || '0';
        if (statDrops) statDrops.textContent = `${files.length} Staged`;
        const gallery = document.getElementById('dedicated-drops-gallery');
        if (gallery) {
          if (files.length === 0) {
            gallery.innerHTML = '<div class="text-xs text-slate-500">No drops staged.</div>';
          } else {
            gallery.innerHTML = files.slice(0, 10).map(f => `
              <div class="p-2 rounded bg-[#0B0D13] border border-[#1E2330] flex items-center justify-between text-xs">
                <div class="flex items-center gap-2 truncate">
                  <span>${f.icon || '📁'}</span>
                  <a href="/drops/${encodeURIComponent(f.rel_path)}" target="_blank" class="text-slate-200 hover:text-amber-400 truncate">${escapeHtml(f.name)}</a>
                </div>
                <button onclick="navigator.clipboard.writeText('${f.markdown_link}'); showToast('Markdown link copied!');" class="text-[10px] font-metrics px-2 py-0.5 rounded bg-[#141B26] hover:bg-[#1E2330] border border-[#1E2330] text-slate-300">
                  Copy Link
                </button>
              </div>
            `).join('');
          }
        }
      } catch (err) {
        console.error('Fetch drops error:', err);
      }
    }
    function formatDateTime(str) {
      if (!str) return 'Recently';
      try {
        const clean = str.includes('T') ? str : str.replace(' ', 'T');
        const d = new Date(clean);
        if (isNaN(d.getTime())) return str;
        const now = new Date();
        const isToday = now.toDateString() === d.toDateString();
        const timeStr = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
        const month = d.toLocaleString('en-US', { month: 'short' });
        const day = d.getDate();
        return isToday ? `Today ${timeStr}` : `${month} ${day}, ${timeStr}`;
      } catch(e) {
        return str;
      }
    }
    // Fetch Envelopes
    async function fetchEnvelopes() {
      try {
        const res = await fetch('/api/sync/envelopes');
        if (!res.ok) return;
        const data = await res.json();
        const envs = data.envelopes || [];
        const statSync = document.getElementById('stat-sync-val');
        if (statSync) statSync.textContent = `${envs.length} Ready`;
        const missionSyncTime = document.getElementById('mission-last-sync-time');
        if (missionSyncTime) missionSyncTime.textContent = data.last_sync_timestamp || 'Today';
        const missionList = document.getElementById('mission-envelopes-list');
        if (missionList) {
          missionList.innerHTML = envs.slice(0, 5).map(e => `
            <div class="p-2 rounded bg-[#0B0D13] border border-[#1E2330] flex items-center justify-between text-xs">
