            border-color: rgba(16, 185, 129, 0.4);
        }

        .hero-card.stale {
            border-color: rgba(244, 63, 94, 0.4);
        }

        .hero-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .hero-title-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .status-beacon-wrap {
            position: relative;
            width: 14px;
            height: 14px;
        }

        .status-beacon-ring {
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            background: rgba(16, 185, 129, 0.35);
            animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }

        .status-beacon-dot {
            position: relative;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--neon-emerald);
            box-shadow: 0 0 10px var(--neon-emerald);
        }

        .status-beacon-dot.stale {
            background: var(--neon-rose);
            box-shadow: 0 0 10px var(--neon-rose);
        }
        .status-beacon-ring.stale {
            background: rgba(244, 63, 94, 0.35);
            animation: none;
        }

        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.6); opacity: 0; }
            100% { transform: scale(0.95); opacity: 0; }
        }

        .hero-name {
            font-family: 'Outfit', sans-serif;
            font-size: 15px;
            font-weight: 700;
            color: #fff;
        }

        .hero-status-tag {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 4px;
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: var(--neon-emerald);
        }

        .hero-status-tag.stale {
            background: rgba(244, 63, 94, 0.15);
            border-color: rgba(244, 63, 94, 0.3);
            color: var(--neon-rose);
        }

        .hero-ticker {
            display: flex;
            align-items: baseline;
            gap: 10px;
        }

        .ticker-val {
            font-family: 'JetBrains Mono', monospace;
            font-size: 30px;
            font-weight: 700;
            color: var(--neon-cyan);
            letter-spacing: -0.5px;
        }

        .ticker-label {
            font-size: 12.5px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .hero-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .metric-pill {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-subtle);
            padding: 4px 9px;
            border-radius: 5px;
            color: #cbd5e1;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .metric-pill span.key {
            color: var(--text-muted);
        }
        .metric-pill span.val {
            color: #fff;
            font-weight: 600;
        }

        /* Split Workspace Content */
        .workspace-split {
            flex: 1;
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            gap: 16px;
            min-height: 0; /* Crucial for KI-095 inner flexbox scrolling */
        }

        .panel {
            background: var(--surface-panel);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        }

        .panel-header {
            height: 42px;
            background: rgba(255, 255, 255, 0.025);
            border-bottom: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px;
            flex-shrink: 0;
        }

        .panel-title {
            font-family: 'Outfit', sans-serif;
            font-size: 13.5px;
            font-weight: 700;
            color: #e2e8f0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .panel-body {
            flex: 1;
            padding: 14px;
            overflow-y: auto;
            position: relative;
        }

        /* Custom Inner Scrollbar (KI-095) */
        .panel-body::-webkit-scrollbar {
            width: 4px;
        }
        .panel-body::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }
        .panel-body::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 2px;
        }
        .panel-body::-webkit-scrollbar-thumb:hover {
            background: var(--neon-cyan);
        }

        /* Log Stream Terminal */
        .log-terminal {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11.5px;
            line-height: 1.65;
            color: #cbd5e1;
            white-space: pre-wrap;
            word-break: break-all;
            user-select: text;
        }

        .log-line {
            padding: 3px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            display: flex;
            gap: 8px;
        }

        .log-line:hover {
            background: rgba(255, 255, 255, 0.04);
        }

        .log-time {
            color: #64748b;
            flex-shrink: 0;
        }

        .log-tag {
            color: var(--neon-cyan);
            font-weight: 600;
            flex-shrink: 0;
        }

        .log-msg {
            color: #e2e8f0;
            word-break: break-all;
        }

        /* Scratchpad Preview Box */
        .scratchpad-view {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11.5px;
            line-height: 1.55;
            color: #cbd5e1;
            white-space: pre-wrap;
            user-select: text;
        }

        .scratchpad-active-banner {
            background: rgba(0, 180, 216, 0.12);
            border-left: 3px solid var(--neon-cyan);
            padding: 9px 12px;
            border-radius: 0 6px 6px 0;
            margin-bottom: 12px;
            font-size: 12px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Footer Bar */
        footer {
            height: 38px;
            background: rgba(13, 18, 29, 0.95);
            border-top: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            font-size: 11.5px;
            color: var(--text-muted);
            flex-shrink: 0;
        }

        .footer-services {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .service-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
        }

        .service-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--neon-emerald);
            box-shadow: 0 0 6px var(--neon-emerald);
        }
    </style>
</head>
<body>
    <!-- Top Header -->
    <header>
        <div class="brand">
            <div class="brand-crest">⚡</div>
            <div class="brand-text">
                <div class="brand-title">SOVEREIGN DAEMON PULSE <span style="font-size:10px; background:rgba(0,180,216,0.2); color:var(--neon-cyan); border:1px solid rgba(0,180,216,0.3); padding:2px 6px; border-radius:4px;">LIVE HUD</span></div>
                <div class="brand-subtitle">Autonomous Workhorse Engine Room • Node Clio (.70) • Cockpit Gateway</div>
            </div>
        </div>
        <div class="header-actions">
            <div class="theme-strip">
              <button class="theme-btn active" data-theme="sovereign" title="Sovereign Void">⚡ Void</button>
              <button class="theme-btn" data-theme="stark" title="Stark S Suit">🦾 Stark</button>
              <button class="theme-btn" data-theme="mets" title="Amazin' Mets">⚾ Mets</button>
            </div>
            <a href="/" class="btn-nav">📷 Pilot Drops</a>
            <a href="/sync" class="btn-nav" style="border-color: rgba(0,255,136,0.35); color: #00ff88;">🚀 Sync Cockpit</a>
            <a href="https://clio.taila01894.ts.net:8095/" target="_blank" class="btn-nav">🏛️ SDLC Portal</a>
            <div class="clock-badge" id="liveClock">00:00:00 EDT</div>
        </div>
    </header>

    <!-- Main Workspace Frame -->
    <main>
        <!-- Hero Row: Poller Liveness -->
        <div class="hero-row">
            <!-- Scratchpad Poller Card -->
            <div class="hero-card live" id="spCard">
                <div class="hero-header">
                    <div class="hero-title-group">
                        <div class="status-beacon-wrap">
                            <div class="status-beacon-ring" id="spBeaconRing"></div>
                            <div class="status-beacon-dot" id="spBeaconDot"></div>
                        </div>
                        <div class="hero-name">Scratchpad & Pilot Drops Poller</div>
                    </div>
                    <div class="hero-status-tag" id="spStatusTag">LISTENING</div>
                </div>
                <div class="hero-ticker">
                    <div class="ticker-val" id="spTickerVal">0.0s</div>
                    <div class="ticker-label">since last poll cycle</div>
                </div>
                <div class="hero-pills">
                    <div class="metric-pill"><span class="key">PID:</span> <span class="val" id="spPid">--</span></div>
                    <div class="metric-pill"><span class="key">Polls:</span> <span class="val" id="spPollCount">--</span></div>
                    <div class="metric-pill"><span class="key">SHA:</span> <span class="val" id="spSha">--</span></div>
                    <div class="metric-pill"><span class="key">Unresolved:</span> <span class="val" id="spUnresolved">0</span></div>
                    <div class="metric-pill"><span class="key">Service:</span> <span class="val">scratch-pad-poller.service</span></div>
                </div>
            </div>

            <!-- FanStack Statcast Poller Card -->
            <div class="hero-card live" id="fsCard">
                <div class="hero-header">
                    <div class="hero-title-group">
                        <div class="status-beacon-wrap">
                            <div class="status-beacon-ring" id="fsBeaconRing"></div>
                            <div class="status-beacon-dot" id="fsBeaconDot"></div>
                        </div>
                        <div class="hero-name">FanStack Statcast Poller</div>
                    </div>
                    <div class="hero-status-tag" id="fsStatusTag">STREAMING</div>
                </div>
                <div class="hero-ticker">
                    <div class="ticker-val" id="fsTickerVal">0.0s</div>
                    <div class="ticker-label">since live Statcast sync</div>
                </div>
                <div class="hero-pills">
                    <div class="metric-pill"><span class="key">PID:</span> <span class="val" id="fsPid">--</span></div>
                    <div class="metric-pill"><span class="key">Live Games:</span> <span class="val" id="fsGames">0</span></div>
                    <div class="metric-pill" style="max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><span class="key">Last Play:</span> <span class="val" id="fsLastPlay">--</span></div>
                    <div class="metric-pill"><span class="key">Service:</span> <span class="val">fanstack-poller.service</span></div>
                </div>
            </div>
        </div>

        <!-- Split Workspace Content -->
        <div class="workspace-split">
            <!-- Left: Scratchpad Active Queue -->
            <div class="panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <span>📝</span>
                        <span>Scratchpad Active State & Work Order Queue</span>
                    </div>
                    <span style="font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--text-muted);">/pilot_drops/scratch_pad.md</span>
                </div>
                <div class="panel-body" id="scratchpadBody">
                    <div class="scratchpad-active-banner" id="activeOrderBanner">
                        <span>⚡</span>
                        <span id="activeOrderText">Scanning scratchpad...</span>
                    </div>
                    <pre class="scratchpad-view" id="scratchpadView">Loading scratchpad contents...</pre>
                </div>
            </div>

            <!-- Right: Rolling Log Stream Tail -->
            <div class="panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <span>⚡</span>
                        <span>Poller Execution Stream (Live Tail)</span>
                    </div>
                    <span style="font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--neon-cyan);">logs/scratch_pad_poller.log</span>
                </div>
                <div class="panel-body" id="logBody">
                    <div class="log-terminal" id="logTerminal">Loading log stream...</div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer Bar -->
    <footer>
        <div class="footer-services">
            <div class="service-badge"><div class="service-dot"></div> scratch-pad-poller: ACTIVE</div>
            <div class="service-badge"><div class="service-dot"></div> fanstack-poller: ACTIVE</div>
            <div class="service-badge"><div class="service-dot"></div> pilot-drop: :8088</div>
            <div class="service-badge"><div class="service-dot"></div> sdlc-portal: :8095</div>
        </div>
        <div style="font-family:'JetBrains Mono', monospace; font-size:11px; color:#64748b;">
            Auto-refreshes every 1.5s • KI-095 Viewport Locked
        </div>
    </footer>

    <script>
        let lastSpServerSec = 0;
        let lastFsServerSec = 0;
        let lastFetchTime = performance.now();

        // Update live clock
        function updateClock() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('en-US', { hour12: false, timeZone: 'America/New_York' }) + ' EDT';
            document.getElementById('liveClock').textContent = timeStr;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // High-frequency sub-second relative ticker (100ms)
        function updateTickers() {
            const elapsedSinceFetch = (performance.now() - lastFetchTime) / 1000;
            const currentSpSec = Math.max(0, lastSpServerSec + elapsedSinceFetch);
            const currentFsSec = Math.max(0, lastFsServerSec + elapsedSinceFetch);

            const spTickerEl = document.getElementById('spTickerVal');
            const fsTickerEl = document.getElementById('fsTickerVal');

            if (spTickerEl) spTickerEl.textContent = currentSpSec.toFixed(1) + 's';
            if (fsTickerEl) fsTickerEl.textContent = currentFsSec.toFixed(1) + 's';

            // Staleness visual guards
            const spCard = document.getElementById('spCard');
            const spDot = document.getElementById('spBeaconDot');
            const spRing = document.getElementById('spBeaconRing');
            const spTag = document.getElementById('spStatusTag');

            if (currentSpSec > 8.0) {
                spCard.className = 'hero-card stale';
                spDot.className = 'status-beacon-dot stale';
                spRing.className = 'status-beacon-ring stale';
                spTag.className = 'hero-status-tag stale';
                spTag.textContent = 'STALE';
            } else {
                spCard.className = 'hero-card live';
                spDot.className = 'status-beacon-dot';
                spRing.className = 'status-beacon-ring';
            }

            const fsCard = document.getElementById('fsCard');
            const fsDot = document.getElementById('fsBeaconDot');
            const fsRing = document.getElementById('fsBeaconRing');
            const fsTag = document.getElementById('fsStatusTag');

            if (currentFsSec > 12.0) {
                fsCard.className = 'hero-card stale';
                fsDot.className = 'status-beacon-dot stale';
                fsRing.className = 'status-beacon-ring stale';
                fsTag.className = 'hero-status-tag stale';
                fsTag.textContent = 'STALE';
            } else {
                fsCard.className = 'hero-card live';
                fsDot.className = 'status-beacon-dot';
                fsRing.className = 'status-beacon-ring';
            }
        }
        setInterval(updateTickers, 100);

        // Fetch live state from /api/pulse
        async function fetchPulse() {
            try {
                const res = await fetch('/api/pulse');
                if (!res.ok) return;
                const data = await res.json();

                lastFetchTime = performance.now();
                lastSpServerSec = data.scratch_pad_poller.delta_seconds || 0;
                lastFsServerSec = data.fanstack_poller.delta_seconds || 0;

                // Update Scratchpad Poller Hero
                const sp = data.scratch_pad_poller;
                if (sp) {
                    document.getElementById('spPid').textContent = sp.pid || '--';
                    document.getElementById('spPollCount').textContent = sp.poll_count ? '#' + sp.poll_count.toLocaleString() : '--';
                    document.getElementById('spSha').textContent = sp.scratch_pad_sha256 || '--';
                    document.getElementById('spUnresolved').textContent = sp.unresolved_tasks_count !== undefined ? sp.unresolved_tasks_count : '0';
                    const spTag = document.getElementById('spStatusTag');
                    if (sp.delta_seconds <= 8.0) {
                        spTag.className = 'hero-status-tag';
                        spTag.textContent = sp.status || 'LISTENING';
                    }
                }

                // Update FanStack Poller Hero
                const fs = data.fanstack_poller;
                if (fs) {
                    document.getElementById('fsPid').textContent = fs.pid || '--';
                    document.getElementById('fsGames').textContent = fs.active_games_count !== undefined ? fs.active_games_count : '0';
                    document.getElementById('fsLastPlay').textContent = fs.last_play_desc || 'In-between pitches';
                    const fsTag = document.getElementById('fsStatusTag');
                    if (fs.delta_seconds <= 12.0) {
                        fsTag.className = 'hero-status-tag';
                        fsTag.textContent = fs.status || 'STREAMING';
                    }
                }

                // Update Scratchpad Active Order & View
                document.getElementById('activeOrderText').textContent = data.active_work_order || 'No active work orders';
                document.getElementById('scratchpadView').textContent = data.scratch_pad_preview || '(scratch_pad.md is empty)';

                // Update Log Terminal
                const terminal = document.getElementById('logTerminal');
                if (data.log_tail && data.log_tail.length > 0) {
                    terminal.innerHTML = data.log_tail.map(line => {
                        const escaped = line.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                        return `<div class="log-line"><span class="log-msg">${escaped}</span></div>`;
                    }).join('');
                    
                    const logBody = document.getElementById('logBody');
                    logBody.scrollTop = logBody.scrollHeight;
                }
            } catch (err) {
                console.error("Pulse fetch error:", err);
            }
        }

        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('sovereign_theme', theme);
            document.querySelectorAll('.theme-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.theme === theme);
            });
        }
        const savedTheme = localStorage.getItem('sovereign_theme') || 'sovereign';
        setTheme(savedTheme);
        document.querySelectorAll('.theme-btn').forEach(btn => {
            btn.addEventListener('click', () => setTheme(btn.dataset.theme));
        });

        // Poll every 1.5s
        fetchPulse();
        setInterval(fetchPulse, 1500);
    </script>
</body>
</html>
"""


# --- SOVEREIGN SYNC COCKPIT HTML TEMPLATE (WO0010240 / Tool #43) ---
SYNC_HTML_TEMPLATE = """<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Sovereign Sync Cockpit | Tool #43 // Iron Man HUD</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --void: #080a0f;
            --panel: #0d1118;
            --panel-raised: #111722;
            --cyan: #00f0ff;
            --gold: #ffd700;
            --crimson: #ff2a4b;
            --green: #55f69a;
            --line: rgba(0, 240, 255, 0.2);
            --mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
            --outfit: 'Outfit', -apple-system, sans-serif;
            --inter: 'Inter', -apple-system, sans-serif;
        }

        /* Eradicate all browser scrollbars completely per Pilot Edict */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            scrollbar-width: none !important;
            -ms-overflow-style: none !important;
        }
        *::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }

        body {
            min-width: 320px;
            background: var(--void);
            color: #dce9ef;
            font-family: var(--mono);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            background-image: 
                radial-gradient(circle at 50% -15%, rgba(0, 240, 255, 0.12), transparent 45%),
                radial-gradient(circle at 10% 80%, rgba(255, 215, 0, 0.04), transparent 40%),
                radial-gradient(circle at 90% 90%, rgba(85, 246, 154, 0.04), transparent 45%);
        }

        button {
            font: inherit;
        }

        .cockpit-shell {
            min-height: 100vh;
            position: relative;
        }

        .cockpit-content {
            position: relative;
            z-index: 1;
            width: min(1540px, 100%);
            margin: auto;
            padding: 24px clamp(16px, 3vw, 46px) 32px;
        }

        /* Subtle repeating scanlines overlay */
        .scanlines {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 99;
            opacity: .12;
            background: repeating-linear-gradient(135deg, transparent 0 7px, rgba(0, 240, 255, .08) 8px 9px);
            mix-blend-mode: screen;
        }

        /* Topbar Header */
        .topbar {
            display: flex;
            align-items: center;
            gap: 24px;
            padding-bottom: 18px;
            border-bottom: 1px solid var(--line);
        }

        .brand-lockup {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: max-content;
        }

        /* Arc-Reactor Rotating Hexagon */
        .reactor {
            display: grid;
            place-items: center;
            width: 44px;
            height: 44px;
            color: var(--cyan);
            filter: drop-shadow(0 0 10px var(--cyan));
            animation: spin 8s linear infinite;
        }
        .reactor svg {
            width: 32px;
            height: 32px;
            stroke-width: 1.5;
        }

        .eyebrow {
            font-size: 10px;
            letter-spacing: .14em;
            color: var(--gold);
            margin-bottom: 4px;
            font-weight: 700;
        }

        h1 {
            margin: 0;
            color: #f1fbff;
            font-family: var(--outfit);
            font-size: clamp(16px, 1.8vw, 24px);
            letter-spacing: .08em;
            font-weight: 800;
            line-height: 1.1;
        }
        h1 span {
            color: var(--cyan);
            font-family: var(--mono);
            font-size: 0.75em;
            font-weight: 500;
        }

        .connection {
            display: flex;
            gap: 8px;
            align-items: center;
            margin-left: auto;
            color: #87a0aa;
            white-space: nowrap;
            font-size: 10.5px;
            letter-spacing: .12em;
        }
        .cyan-text {
            color: var(--cyan) !important;
        }
        .pulse-dot, .green-dot, .live-chip span {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 10px var(--green);
        }
        .pulse-dot {
            animation: pulse-glow 2s infinite ease-in-out;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .drive-button, .inventory-actions button, .icon-button {
            cursor: pointer;
            color: var(--cyan);
            background: rgba(0, 240, 255, 0.04);
            border: 1px solid var(--line);
            transition: all .2s ease;
            font-family: var(--mono);
            border-radius: 4px;
        }
        .drive-button {
            padding: 9px 14px;
            font-size: 10px;
            letter-spacing: .08em;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 7px;
            font-weight: 700;
        }
        .drive-button:hover, .inventory-actions button:hover, .icon-button:hover {
            border-color: var(--cyan);
            background: rgba(0, 240, 255, .12);
            box-shadow: 0 0 18px rgba(0, 240, 255, .25);
            color: #fff;
        }
        .drive-button svg, .status-rail svg, .path-cell svg, .inventory-actions svg, .inventory-footer svg, .footer-bar svg, .icon-button svg {
            width: 14px;
            height: 14px;
            vertical-align: middle;
        }

        .theme-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #718790;
            white-space: nowrap;
            font-size: 10px;
            letter-spacing: .12em;
        }
        .theme-orb {
            width: 8px;
            height: 8px;
            background: var(--gold);
            box-shadow: 0 0 12px var(--gold);
            transform: rotate(45deg);
        }

        /* Status Rail */
        .status-rail {
            display: flex;
            flex-wrap: wrap;
            gap: 22px;
            padding: 12px 0 18px;
            color: #76909a;
            font-size: 10px;
            letter-spacing: .12em;
            border-bottom: 1px solid rgba(0, 240, 255, 0.08);
            margin-bottom: 18px;
        }
        .status-rail span {
            display: flex;
            align-items: center;
            gap: 7px;
        }
        .status-live {
            color: var(--green) !important;
            font-weight: 700;
        }

        /* Iron Man HUD Corner Brackets Card (.corner-frame) */
        .corner-frame {
            position: relative;
            border: 1px solid var(--line);
            background: linear-gradient(135deg, rgba(13, 22, 32, .92), rgba(8, 12, 18, .96));
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
        }
        .corner-frame::before, .corner-frame::after {
            content: '';
            position: absolute;
            width: 14px;
            height: 14px;
            border-color: var(--cyan);
            border-style: solid;
            pointer-events: none;
            box-shadow: 0 0 8px rgba(0, 240, 255, 0.4);
        }
        .corner-frame::before {
            top: -1px;
            left: -1px;
            border-width: 2px 0 0 2px;
        }
        .corner-frame::after {
            right: -1px;
            bottom: -1px;
            border-width: 0 2px 2px 0;
        }

        .envelope-panel {
            padding: 20px;
        }
        .section-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            color: #effcff;
            font-weight: 700;
            font-size: 10.5px;
            letter-spacing: .12em;
        }
        .section-label em {
            color: var(--cyan);
            font-style: normal;
        }
        .label-code {
            color: #67828b;
            font-weight: 400;
        }

        /* Envelope Grid - Kills horizontal scrollbar per Pilot Edict */
        .envelope-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 18px 0 14px;
        }
        .envelope-pill {
            position: relative;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px 14px;
            color: #b5cbd0;
            background: rgba(18, 28, 37, .82);
            border: 1px solid rgba(134, 166, 176, .2);
            cursor: pointer;
            transition: all .2s ease;
            user-select: none;
            font-family: var(--mono);
            font-size: 12px;
            border-radius: 4px;
        }
        .envelope-pill:hover {
            color: #f4ffff;
            border-color: var(--cyan);
            transform: translateY(-1px);
            box-shadow: 0 0 16px rgba(0, 240, 255, .25), inset 0 0 14px rgba(0, 240, 255, .06);
        }
        .envelope-pill.active {
            color: #f4ffff;
            border-color: var(--cyan);
            background: rgba(0, 240, 255, 0.12);
            box-shadow: 0 0 20px rgba(0, 240, 255, .35), inset 0 0 18px rgba(0, 240, 255, .1);
        }
        .envelope-pill.gold.active {
            border-color: var(--gold);
            background: rgba(255, 215, 0, 0.1);
            box-shadow: 0 0 20px rgba(255, 215, 0, .3), inset 0 0 18px rgba(255, 215, 0, .08);
        }
        .envelope-icon {
            font-size: 16px;
        }
        .envelope-pill b {
            color: var(--gold);
            font-weight: 700;
        }
        .envelope-pill small {
            color: #6e8991;
            font-size: 9.5px;
            margin-left: 6px;
            padding: 1px 5px;
            background: rgba(0, 0, 0, 0.35);
            border-radius: 3px;
        }
        .pill-check {
            width: 14px;
            height: 14px;
            color: var(--cyan);
            margin-left: 2px;
        }
        .envelope-pill.gold.active .pill-check {
            color: var(--gold);
        }

        /* Active Strip */
        .active-strip {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            color: #6e8a94;
            background: rgba(0, 240, 255, .05);
            border-left: 3px solid var(--cyan);
            font-size: 10.5px;
            letter-spacing: .08em;
            margin-top: 4px;
        }
        .active-strip strong {
            color: #f5ffff;
            font-weight: 700;
        }
        .strip-mark svg {
            width: 16px;
            height: 16px;
            color: var(--cyan);
            display: block;
        }
        .strip-divider {
            width: 1px;
            height: 16px;
            background: var(--line);
        }
        .strip-spacer {
            flex: 1;
        }
        .integrity {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--green);
            font-weight: 700;
        }
        .integrity svg {
            width: 13px;
            height: 13px;
        }

        /* Path Row with Clean Mode Switch */
        .path-row {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 16px;
        }
        .path-cell {
            flex: 1;
            min-width: 0;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(134, 166, 176, .15);
            padding: 8px 12px;
            border-radius: 4px;
        }
        .path-cell span {
            display: block;
            color: #66828d;
            margin-bottom: 5px;
            font-size: 9.5px;
            letter-spacing: .12em;
        }
        .path-cell strong {
            display: flex;
            align-items: center;
            gap: 8px;
            overflow: hidden;
            color: #bcd4da;
            font-size: 11px;
            font-weight: 400;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .path-cell strong svg {
            flex: none;
            color: var(--cyan);
            width: 14px;
            height: 14px;
        }
        .path-arrow {
            color: var(--gold);
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        /* Tactical Clean Mode Switch */
        .clean-switch {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
            padding: 8px 12px;
            color: #728891;
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(134, 166, 176, .2);
            cursor: pointer;
            border-radius: 4px;
            transition: all .2s;
            user-select: none;
            min-width: 150px;
        }
        .clean-switch:hover {
            border-color: rgba(85, 246, 154, .4);
        }
        .clean-switch.on {
            color: var(--green);
            border-color: rgba(85, 246, 154, .5);
            background: rgba(85, 246, 154, 0.05);
        }
        .switch-knob {
            width: 28px;
            height: 10px;
            background: #33434a;
            position: relative;
            border-radius: 6px;
            transition: .2s;
        }
        .switch-knob::after {
            content: '';
            position: absolute;
            width: 14px;
            height: 14px;
            top: -2px;
            left: 0;
            background: #81939a;
            border-radius: 50%;
            transition: .2s;
        }
        .clean-switch.on .switch-knob {
            background: rgba(85, 246, 154, .3);
        }
        .clean-switch.on .switch-knob::after {
            left: 14px;
            background: var(--green);
            box-shadow: 0 0 10px var(--green);
        }
        .clean-switch span:not(.switch-knob) {
            font-size: 9px;
            letter-spacing: .1em;
            font-weight: 700;
        }
        .clean-switch b {
            font-size: 9px;
            letter-spacing: .08em;
            font-weight: 700;
        }

        /* Dashboard Grid: Inventory + Telemetry */
        .dashboard-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.25fr) minmax(360px, .75fr);
            gap: 16px;
            margin-top: 16px;
        }
        .inventory-card, .telemetry-card {
            padding: 20px;
            min-width: 0;
        }
        .inventory-actions {
            display: flex;
            gap: 8px;
        }
        .inventory-actions button {
            padding: 6px 10px;
            font-size: 9.5px;
            display: flex;
            align-items: center;
            gap: 5px;
            font-weight: 700;
        }

        .inventory-meta {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 18px 0 10px;
            color: #66818b;
            font-size: 10px;
            letter-spacing: .1em;
        }
        .inventory-meta b {
            color: var(--green);
        }
        .meta-spacer {
            flex: 1;
        }

        .filter-pills {
            display: flex;
            gap: 6px;
        }
        .tab-filter-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(134, 166, 176, 0.2);
            color: #728a94;
            padding: 4px 10px;
            font-size: 9.5px;
            cursor: pointer;
            border-radius: 3px;
            transition: all 0.2s;
            font-family: var(--mono);
        }
        .tab-filter-btn.active {
            color: var(--cyan);
            border-color: var(--cyan);
            background: rgba(0, 240, 255, 0.12);
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
        }

        /* File List */
        .file-list {
            border-top: 1px solid rgba(134, 166, 176, .15);
            max-height: 420px;
            overflow-y: auto;
        }
        .file-row {
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 52px;
            padding: 6px 8px;
            border-bottom: 1px solid rgba(134, 166, 176, .12);
            color: #a7c1c8;
            font-size: 11px;
            transition: background .15s ease;
        }
        .file-row:hover {
            background: rgba(0, 240, 255, .04);
        }
        .check-box {
            display: grid;
            place-items: center;
            width: 17px;
            height: 17px;
            padding: 0;
            border: 1px solid #49616a;
            background: transparent;
            color: var(--void);
            cursor: pointer;
            border-radius: 2px;
            flex-shrink: 0;
            transition: all .15s ease;
        }
        .check-box.checked {
            background: var(--green);
            border-color: var(--green);
        }
        .check-box svg {
            width: 12px;
            height: 12px;
            stroke: #000;
            stroke-width: 3;
            display: block;
        }
        .file-type {
            width: 34px;
            padding: 3px 2px;
            text-align: center;
            color: var(--cyan);
            border: 1px solid rgba(0, 240, 255, .28);
            background: rgba(0, 240, 255, 0.05);
            font-size: 8.5px;
            font-weight: 700;
            border-radius: 2px;
            flex-shrink: 0;
        }
        .file-name {
            display: flex;
            flex: 1;
            flex-direction: column;
            gap: 3px;
            min-width: 0;
        }
        .file-name b {
            overflow: hidden;
            color: #d9edf1;
            font-weight: 500;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .file-name span {
            color: #607b84;
            font-size: 9.5px;
        }
        .file-size {
            color: #77939b;
            white-space: nowrap;
            font-size: 10px;
        }
        .pristine-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--green);
            font-size: 9.5px;
            white-space: nowrap;
            padding: 2px 7px;
            background: rgba(85, 246, 154, 0.08);
            border: 1px solid rgba(85, 246, 154, 0.25);
            border-radius: 3px;
        }
        .pristine-badge.clutter {
            color: var(--crimson);
            background: rgba(255, 42, 75, 0.08);
            border-color: rgba(255, 42, 75, 0.25);
        }
        .pristine-badge span {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 8px var(--green);
        }
        .pristine-badge.clutter span {
            background: var(--crimson);
            box-shadow: 0 0 8px var(--crimson);
        }
        .inventory-footer, .terminal-footer {
            display: flex;
            align-items: center;
            gap: 15px;
            padding-top: 14px;
            color: #6d8992;
            font-size: 10px;
            letter-spacing: .08em;
        }
        .inventory-footer span {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .inventory-footer b {
            color: #d8edf0;
        }
        .footer-ready {
            margin-left: auto;
            color: var(--green);
            font-weight: 700;
        }

        /* CRT Terminal & Live Telemetry */
        .live-chip {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--green);
            font-weight: 700;
            font-size: 10px;
        }
        .terminal {
            margin-top: 18px;
            background: #050909;
            border: 1px solid rgba(85, 246, 154, .25);
            box-shadow: inset 0 0 30px rgba(0, 255, 150, .04);
            border-radius: 4px;
            overflow: hidden;
        }
        .terminal-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 9px 12px;
            color: #628177;
            background: rgba(85, 246, 154, 0.04);
            border-bottom: 1px solid rgba(85, 246, 154, .18);
            font-size: 10px;
            letter-spacing: .08em;
        }
        .terminal-bar b {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #a6cab5;
            font-weight: 500;
        }
        .terminal-bar svg {
            width: 12px;
            height: 12px;
        }
        .terminal-body {
            min-height: 240px;
            max-height: 310px;
            overflow-y: auto;
            padding: 14px 12px;
            color: #8ebca2;
            font-size: 10.5px;
            line-height: 1.9;
            font-family: var(--mono);
        }
        .log-line, .cursor-line {
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }
        .log-time {
            color: #476955;
            white-space: nowrap;
        }
        .log-level {
            width: 36px;
            color: var(--green);
            font-weight: 700;
            text-align: left;
        }
        .log-level.link {
            color: var(--cyan);
        }
        .log-level.wait {
            color: var(--gold);
        }
        .log-level.err, .log-level.error {
            color: var(--crimson);
        }
        .cursor-block {
            display: inline-block;
            width: 7px;
            height: 14px;
            background: var(--green);
            animation: blink 1s steps(2) infinite;
            vertical-align: middle;
        }
        .terminal-footer {
            justify-content: space-between;
            padding: 8px 12px;
            background: rgba(85, 246, 154, 0.03);
            border-top: 1px solid rgba(85, 246, 154, .15);
        }
        .terminal-footer span:first-child {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--green);
        }

        .telemetry-stats {
            display: flex;
            gap: 10px;
            margin-top: 14px;
        }
        .telemetry-stats div {
            flex: 1;
            padding: 10px 12px;
            border: 1px solid rgba(134, 166, 176, .16);
            background: rgba(0, 0, 0, 0.25);
            border-radius: 4px;
        }
        .telemetry-stats span {
            display: block;
            color: #5f7b83;
            font-size: 8.5px;
            letter-spacing: .12em;
        }
        .telemetry-stats strong {
            display: block;
            margin-top: 6px;
            color: #f0fbfc;
            font-size: 18px;
            font-weight: 700;
            font-family: var(--outfit);
        }

        /* Radiant High-Energy Quantum Trigger Button */
        .engage-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            width: 100%;
            margin-top: 18px;
            padding: 18px;
            color: var(--void);
            background: linear-gradient(135deg, #00f0ff 0%, #70f7ff 100%);
            border: 1px solid #bafaff;
            box-shadow: 0 0 28px rgba(0, 240, 255, .35), inset 0 0 14px rgba(255, 255, 255, .5);
            cursor: pointer;
            font-size: 13.5px;
            font-weight: 800;
            letter-spacing: .14em;
            font-family: var(--mono);
            border-radius: 4px;
            transition: all .2s ease;
            position: relative;
            overflow: hidden;
        }
        .engage-button:hover:not(:disabled) {
            background: #b8fbff;
            box-shadow: 0 0 45px rgba(0, 240, 255, .7), inset 0 0 20px rgba(255, 255, 255, .8);
            transform: translateY(-2px);
        }
        .engage-button.syncing {
            color: var(--void);
            background: linear-gradient(135deg, #ffd700 0%, #ffe970 100%);
            border-color: #fff0a0;
            box-shadow: 0 0 35px rgba(255, 215, 0, .6), inset 0 0 16px rgba(255, 255, 255, .6);
        }
        .engage-button:disabled {
            cursor: not-allowed;
            opacity: 0.85;
        }
        .engage-icon svg {
            width: 20px;
            height: 20px;
            display: block;
        }
        .engage-button > svg {
            width: 18px;
            height: 18px;
        }

        /* Footer */
        .footer-bar {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 14px;
            padding-top: 20px;
            color: #5f7982;
            font-size: 10px;
            letter-spacing: .1em;
            border-top: 1px solid rgba(0, 240, 255, 0.08);
            margin-top: 24px;
        }
        .footer-bar span {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .footer-bar b {
            color: #a7c0c6;
            font-weight: 600;
        }

        /* Keyframes */
        @keyframes blink {
            50% { opacity: 0; }
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        @keyframes pulse-glow {
            0%, 100% { opacity: 1; box-shadow: 0 0 10px var(--green); }
            50% { opacity: 0.4; box-shadow: 0 0 4px var(--green); }
        }

        /* Responsive Breakpoints */
        @media (max-width: 1050px) {
            .topbar {
                flex-wrap: wrap;
            }
            .connection {
                order: 3;
                width: 100%;
                margin-left: 0;
            }
            .top-actions {
                margin-left: auto;
            }
            .dashboard-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 700px) {
            .cockpit-content {
                padding: 16px 12px;
            }
            .top-actions {
                width: 100%;
                margin-left: 0;
            }
            .drive-button {
                flex: 1;
            }
            .theme-indicator {
                margin-left: auto;
            }
            .path-row {
                flex-direction: column;
                align-items: stretch;
            }
            .path-arrow {
                align-self: center;
                transform: rotate(90deg);
            }
            .clean-switch {
                align-self: flex-start;
                width: 100%;
            }
            .section-label {
                align-items: flex-start;
                flex-direction: column;
            }
            .label-code {
                align-self: flex-start;
            }
            .inventory-actions {
                width: 100%;
            }
            .inventory-actions button {
                flex: 1;
            }
            .file-row {
                gap: 8px;
            }
            .file-size {
                display: none;
            }
            .pristine-badge {
                margin-left: auto;
            }
            .active-strip {
                flex-wrap: wrap;
            }
            .strip-spacer {
                display: none;
            }
            .engage-button {
                font-size: 11px;
                padding: 15px;
            }
            .footer-bar {
                justify-content: flex-start;
            }
        }
    </style>
</head>
<body>
    <div class="scanlines" aria-hidden="true"></div>

    <div class="cockpit-shell">
        <div class="cockpit-content">
            <!-- 1. Iron Man Avionics Topbar Header -->
            <header class="topbar">
                <div class="brand-lockup">
                    <div class="reactor" title="Arc Reactor Containment Core">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"></polygon>
                            <circle cx="12" cy="12" r="4"></circle>
                        </svg>
                    </div>
                    <div>
                        <div class="eyebrow">STACKLABS / SECURE OPERATIONS</div>
                        <h1>SOVEREIGN SYNC COCKPIT <span>// TOOL #43</span></h1>
                    </div>
                </div>

                <div class="connection">
                    <span class="pulse-dot"></span>
                    <span>UHF LINK: 100.73.155.70:8088</span>
                    <b>|</b>
                    <span class="cyan-text">SECURE MESH</span>
                </div>

                <div class="top-actions">
                    <button type="button" class="drive-button" id="btnPullDrive" title="Pull Google Drive Inbox into sovereign_inbox">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
                            <path d="M12 12v9"></path>
                            <path d="m8 17 4 4 4-4"></path>
                        </svg>
                        PULL GOOGLE DRIVE INBOX
                    </button>
                    <div class="theme-indicator">
                        <div class="theme-orb"></div>
                        <span id="themeClock">VOID // 00:00:00 Z</span>
                    </div>
                </div>
            </header>

            <!-- 2. System Avionics Status Rail -->
            <div class="status-rail">
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 14 14"></polyline>
                    </svg>
                    SYSTEMS NOMINAL
                </span>
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    ENCRYPTION: AES-256-GCM
                </span>
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                        <path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
                        <path d="M3 12A9 3 0 0 0 21 12"></path>
                    </svg>
                    LOCAL CACHE: 2.84 GB
                </span>
                <span class="status-live">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"></path>
                        <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"></path>
                        <circle cx="12" cy="12" r="2"></circle>
                        <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"></path>
                        <path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"></path>
                    </svg>
                    LIVE TELEMETRY
                </span>
            </div>

            <!-- 3. Tactical Dossier Envelopes (Dynamic Grid, No Scrollbar) -->
            <div class="corner-frame envelope-panel">
                <div class="section-label">
                    <span>TACTICAL DOSSIER ENVELOPES <em>[ SELECT VECTOR ]</em></span>
                    <span class="label-code" id="vectorRegistryLabel">VECTOR REGISTRY / 00 ACTIVE</span>
                </div>

                <!-- Dynamic Folder Discovery Grid (Flex-wrap, zero scrollbar) -->
                <div class="envelope-grid" id="envelopeGrid">
                    <!-- Populated dynamically via fetchEnvelopes() -->
                </div>

                <!-- Active Strip -->
                <div class="active-strip" id="activeStrip">
                    <span class="strip-mark">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="22" x2="18" y1="12" y2="12"></line>
                            <line x1="6" x2="2" y1="12" y2="12"></line>
                            <line x1="12" x2="12" y1="6" y2="2"></line>
                            <line x1="12" x2="12" y1="22" y2="18"></line>
                        </svg>
                    </span>
                    <span>ACTIVE VECTOR</span>
                    <strong id="activeVectorName">🪚 07 / JOHNNY CARROLL</strong>
                    <span class="strip-divider"></span>
                    <span id="activeSourcesCount">00 SOURCE NODES</span>
                    <span class="strip-spacer"></span>
                    <span class="integrity">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        INTEGRITY LOCKED
                    </span>
                </div>

                <!-- Path Row with Clean Source Mode Switch -->
                <div class="path-row">
                    <div class="path-cell">
                        <span>LOCAL SOURCE VAULT</span>
                        <strong>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect width="20" height="8" x="2" y="2" rx="2"></rect>
                                <rect width="20" height="8" x="2" y="14" rx="2"></rect>
                                <line x1="6" x2="6.01" y1="6" y2="6"></line>
                                <line x1="6" x2="6.01" y1="18" y2="18"></line>
                            </svg>
                            <span id="envelopeLocalPath">/home/james/sovereign_inbox/notebook_sync/07_JohnnyCarroll_Prospectus</span>
                        </strong>
                    </div>

                    <svg class="path-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>

                    <div class="path-cell">
                        <span>REMOTE GOOGLE DRIVE TARGET</span>
                        <strong>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
                                <path d="M12 12v9"></path>
                                <path d="m8 17 4 4 4-4"></path>
                            </svg>
                            <span id="envelopeRemoteTarget">stacklabs_edge:07_JohnnyCarroll_Prospectus</span>
                        </strong>
                    </div>

                    <button type="button" id="cleanModeToggleBtn" class="clean-switch on" aria-pressed="true" title="Toggle Clean Source Mode (--delete-excluded)">
                        <span class="switch-knob"></span>
                        <span>CLEAN SOURCE MODE</span>
                        <b id="cleanModeStatusText">--delete-excluded</b>
                    </button>
                </div>
            </div>

            <!-- 4. Dashboard Grid: Staged Deliverables + Live CRT Telemetry -->
            <div class="dashboard-grid">
                <!-- Staged Deliverables Card -->
                <div class="corner-frame inventory-card">
                    <div class="section-label">
                        <span>STAGED DELIVERABLES <em>[ PRISTINE SOURCES ONLY: .MD, .PDF, .TXT ]</em></span>
                        <div class="inventory-actions">
                            <button type="button" id="btnSelectAll">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                SELECT ALL
                            </button>
                            <button type="button" id="btnInvert">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                                    <path d="M21 3v5h-5"></path>
                                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                                    <path d="M8 16H3v5"></path>
                                </svg>
                                INVERT
                            </button>
                            <button type="button" id="btnPurgeClutter" style="display:none; color:var(--crimson); border-color:rgba(255,42,75,0.4);">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                                PURGE CLUTTER (<span id="clutterCountBadge">0</span>)
                            </button>
                        </div>
                    </div>

                    <div class="inventory-meta">
                        <span><span class="green-dot"></span> <span id="selectedCountText">0 OF 0 SELECTED</span></span>
                        <span>FILTER: <b>PRISTINE</b></span>
                        <span class="meta-spacer"></span>
                        <div class="filter-pills">
                            <button type="button" class="tab-filter-btn active" id="tabPristine">PRISTINE (<span id="pristineCount">0</span>)</button>
                            <button type="button" class="tab-filter-btn" id="tabAllFiles">ALL (<span id="allFilesCount">0</span>)</button>
                        </div>
                    </div>

                    <!-- File Row List -->
                    <div class="file-list" id="filesList">
                        <div style="padding:24px; text-align:center; color:#5f7b83; font-size:11px;">
                            ⚡ Scanning staged vector deliverables...
                        </div>
                    </div>

                    <div class="inventory-footer">
                        <span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect width="20" height="5" x="2" y="3" rx="1"></rect>
                                <path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"></path>
                                <path d="M10 12h4"></path>
                            </svg>
                            QUEUE SIZE: <b id="queueSizeText">0 OBJECTS</b>
                        </span>
                        <span class="footer-ready">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            READY FOR TRANSMISSION
                        </span>
                    </div>
                </div>

                <!-- Live Telemetry Card -->
                <div class="corner-frame telemetry-card">
                    <div class="section-label">
                        <span>LIVE TELEMETRY <em>[ SSE / ENCRYPTED ]</em></span>
                        <span class="live-chip" id="streamingChip">
                            <span></span>
                            <span id="termStatusText">STREAMING</span>
                        </span>
                    </div>

                    <div class="terminal">
                        <div class="terminal-bar">
                            <span style="display:flex; gap:4px; font-size:9px; color:#476955;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            </span>
                            <b>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
                                    <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
                                    <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
                                    <line x1="12" y1="20" x2="12.01" y2="20"></line>
                                </svg>
                                SYNC_DAEMON / PID 043
                            </b>
                            <span id="latencyDisplay">LATENCY 012ms</span>
                        </div>

                        <div class="terminal-body" id="termBody">
                            <div class="log-line"><span class="log-time" id="initTime">00:00:00.000</span><span class="log-level info">INFO</span><span>envelope vector mounted</span></div>
                            <div class="log-line"><span class="log-time">00:00:00.112</span><span class="log-level info">OK</span><span>pristine filter armed :: md, pdf, txt</span></div>
                            <div class="log-line"><span class="log-time">00:00:00.298</span><span class="log-level info">INFO</span><span>checksum sweep initiated [sha-256]</span></div>
                            <div class="log-line"><span class="log-time">00:00:01.004</span><span class="log-level link">LINK</span><span>google drive uplink negotiated · 8088</span></div>
                            <div class="log-line"><span class="log-time">00:00:01.311</span><span class="log-level wait">WAIT</span><span>standing by for quantum sync trigger</span></div>
                            <div class="cursor-line">
                                <span class="log-time" id="cursorTime">00:00:01.642</span>
                                <span class="log-level wait">EXEC</span>
                                <span class="cursor-block"></span>
                            </div>
                        </div>

                        <div class="terminal-footer">
                            <span><span class="green-dot"></span> CONNECTION STABLE</span>
                            <span>BUFFER 64KB / 64KB</span>
                        </div>
                    </div>

                    <div class="telemetry-stats">
                        <div>
                            <span>PACKETS STAGED</span>
                            <strong id="statPacketsStaged">000</strong>
                        </div>
                        <div>
                            <span>INTEGRITY</span>
                            <strong class="cyan-text" id="statIntegrity">100.0%</strong>
                        </div>
                        <div id="dryRunToggleBox" style="cursor:pointer;" title="Click to toggle Dry Run simulation mode">
                            <span>SIMULATION</span>
                            <strong id="statDryRunMode">OFF</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. Radiant High-Energy Quantum Sync Action Button -->
            <button type="button" class="engage-button" id="btnHeroSync">
                <span class="engage-icon" id="btnEngageIcon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                </span>
                <span id="btnHeroText">ENGAGE QUANTUM SYNC TO DRIVE NOW</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
            </button>

            <!-- 6. Footer Avionics Bar -->
            <footer class="footer-bar">
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    SOVEREIGN SYNC ENGINE v4.3.0
                </span>
                <span>OPERATOR: <b>COMMANDER / ALPHA-7</b></span>
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 10v6"></path>
                        <path d="m9 13 3-3 3 3"></path>
                        <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path>
                    </svg>
                    LAST SYNC: <span id="lastSyncDisplay">09/25/26 20:30:00 Z</span>
                </span>
                <span>BUILD <b>9F3A-77C1</b></span>
            </footer>
        </div>
    </div>

    <!-- Client-Side Avionics Orchestrator Script -->
    <script>
        let activeEnvelope = '07_JohnnyCarroll_Prospectus';
        let envelopes = [];
        let stagedFiles = [];
        let currentTab = 'pristine';
        let isCleanMode = true;
        let isDryRun = false;
        let isSyncing = false;
        let currentTaskId = null;
        let eventSource = null;

        // Elements
        const envelopeGrid = document.getElementById('envelopeGrid');
        const activeVectorName = document.getElementById('activeVectorName');
        const activeSourcesCount = document.getElementById('activeSourcesCount');
        const vectorRegistryLabel = document.getElementById('vectorRegistryLabel');
        const envelopeLocalPath = document.getElementById('envelopeLocalPath');
        const envelopeRemoteTarget = document.getElementById('envelopeRemoteTarget');
        const cleanModeToggleBtn = document.getElementById('cleanModeToggleBtn');
        const cleanModeStatusText = document.getElementById('cleanModeStatusText');
        const filesList = document.getElementById('filesList');
        const selectedCountText = document.getElementById('selectedCountText');
        const pristineCount = document.getElementById('pristineCount');
        const allFilesCount = document.getElementById('allFilesCount');
        const queueSizeText = document.getElementById('queueSizeText');
        const btnSelectAll = document.getElementById('btnSelectAll');
        const btnInvert = document.getElementById('btnInvert');
        const btnPurgeClutter = document.getElementById('btnPurgeClutter');
        const clutterCountBadge = document.getElementById('clutterCountBadge');
        const tabPristine = document.getElementById('tabPristine');
        const tabAllFiles = document.getElementById('tabAllFiles');
        const btnHeroSync = document.getElementById('btnHeroSync');
        const btnHeroText = document.getElementById('btnHeroText');
        const btnEngageIcon = document.getElementById('btnEngageIcon');
        const termBody = document.getElementById('termBody');
        const cursorTime = document.getElementById('cursorTime');
        const statPacketsStaged = document.getElementById('statPacketsStaged');
        const statIntegrity = document.getElementById('statIntegrity');
        const statDryRunMode = document.getElementById('statDryRunMode');
        const dryRunToggleBox = document.getElementById('dryRunToggleBox');
        const themeClock = document.getElementById('themeClock');
        const btnPullDrive = document.getElementById('btnPullDrive');

        // Clock Update
        function updateClock() {
            const now = new Date();
            const timeStr = now.toISOString().slice(11, 19);
            themeClock.textContent = `VOID // ${timeStr} Z`;
            const ms = String(now.getMilliseconds()).padStart(3, '0');
            cursorTime.textContent = `${timeStr}.${ms}`;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // 1. Dynamic Envelope Loading
        async function fetchEnvelopes() {
            try {
                const res = await fetch('/api/sync/envelopes');
                const data = await res.json();
                if (data.status === 'success') {
                    envelopes = data.envelopes || [];
                    vectorRegistryLabel.textContent = `VECTOR REGISTRY / ${String(envelopes.length).padStart(2, '0')} ACTIVE`;
                    renderEnvelopeGrid();
                    updateActiveDisplay();
                    fetchInventory();
                }
            } catch (err) {
                console.error('Error fetching envelopes:', err);
                appendLog('ERR', `Failed to discover envelopes: ${err.message}`);
            }
        }

        function renderEnvelopeGrid() {
            envelopeGrid.innerHTML = envelopes.map(env => {
                const isActive = env.key === activeEnvelope;
                const idDisplay = env.id || env.key.slice(0, 2);
                return `
                    <button type="button" 
                            class="envelope-pill ${env.hue || 'cyan'} ${isActive ? 'active' : ''}" 
                            data-key="${env.key}">
                        <span class="envelope-icon">${env.icon}</span>
                        <span><b>${idDisplay}</b> ${env.name}</span>
                        <small>${String(env.pristine_files || 0).padStart(2, '0')} SRC</small>
                        ${isActive ? `
                            <svg class="pill-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        ` : ''}
                    </button>
                `;
            }).join('');

            envelopeGrid.querySelectorAll('.envelope-pill').forEach(pill => {
                pill.addEventListener('click', () => {
                    const key = pill.dataset.key;
                    if (key === activeEnvelope) return;
                    activeEnvelope = key;
                    renderEnvelopeGrid();
                    updateActiveDisplay();
                    fetchInventory();
                });
            });
        }

        function updateActiveDisplay() {
            const env = envelopes.find(e => e.key === activeEnvelope);
            if (!env) return;
            const idDisplay = env.id || env.key.slice(0, 2);
            activeVectorName.textContent = `${env.icon} ${idDisplay} / ${env.name.toUpperCase()}`;
            activeSourcesCount.textContent = `${String(env.pristine_files || 0).padStart(2, '0')} SOURCE NODES`;
            envelopeLocalPath.textContent = env.path;
            envelopeRemoteTarget.textContent = env.remote;
            updateHeroButton();
        }

        // Clean Mode Toggle
        cleanModeToggleBtn.addEventListener('click', () => {
            isCleanMode = !isCleanMode;
            cleanModeToggleBtn.classList.toggle('on', isCleanMode);
            cleanModeToggleBtn.setAttribute('aria-pressed', isCleanMode);
            cleanModeStatusText.textContent = isCleanMode ? '--delete-excluded' : 'OFF';
            appendLog('INFO', `clean mode toggled: ${isCleanMode ? 'ACTIVE (--delete-excluded)' : 'INACTIVE'}`);
            updateHeroButton();
        });

        // Dry Run Toggle
        dryRunToggleBox.addEventListener('click', () => {
            isDryRun = !isDryRun;
            statDryRunMode.textContent = isDryRun ? 'SIM' : 'OFF';
            statDryRunMode.style.color = isDryRun ? 'var(--gold)' : '#f0fbfc';
            appendLog('WAIT', `dry-run simulation mode: ${isDryRun ? 'ARMED' : 'DISARMED'}`);
            updateHeroButton();
        });

        // Filter Tabs
        tabPristine.addEventListener('click', () => {
            currentTab = 'pristine';
            tabPristine.classList.add('active');
            tabAllFiles.classList.remove('active');
            renderFiles();
            updateSelectionMeta();
        });
        tabAllFiles.addEventListener('click', () => {
            currentTab = 'all';
            tabAllFiles.classList.add('active');
            tabPristine.classList.remove('active');
            renderFiles();
            updateSelectionMeta();
        });

        // 2. Fetch Staged Deliverables
        async function fetchInventory() {
            filesList.innerHTML = '<div style="padding:24px; text-align:center; color:#5f7b83; font-size:11px;">⚡ Scanning staged vector deliverables...</div>';
            try {
                const res = await fetch(`/api/sync/staged?envelope=${encodeURIComponent(activeEnvelope)}`);
                const data = await res.json();
                if (data.status === 'success') {
                    stagedFiles = (data.files || []).map(f => ({
                        ...f,
                        checked: f.is_notebooklm_source
                    }));

                    const pristineTotal = stagedFiles.filter(f => f.is_notebooklm_source).length;
                    const clutterTotal = stagedFiles.filter(f => f.is_clutter).length;

                    pristineCount.textContent = pristineTotal;
                    allFilesCount.textContent = stagedFiles.length;

                    if (clutterTotal > 0) {
                        clutterCountBadge.textContent = clutterTotal;
                        btnPurgeClutter.style.display = 'inline-flex';
                    } else {
                        btnPurgeClutter.style.display = 'none';
                    }

                    renderFiles();
                    updateSelectionMeta();
                    appendLog('INFO', `mounted vector [${data.envelope_name}] · ${stagedFiles.length} files detected`);
                } else {
                    filesList.innerHTML = `<div style="padding:24px; text-align:center; color:var(--crimson); font-size:11px;">Failed to inspect envelope: ${data.message || 'error'}</div>`;
                }
            } catch (err) {
                console.error('Error fetching staged inventory:', err);
                filesList.innerHTML = `<div style="padding:24px; text-align:center; color:var(--crimson); font-size:11px;">Network error loading inventory: ${err.message}</div>`;
            }
        }

        function getFileBadgeType(ext) {
            const clean = ext.replace('.', '').toUpperCase();
            return clean || 'FILE';
        }

        function renderFiles() {
            const visible = currentTab === 'pristine'
                ? stagedFiles.filter(f => f.is_notebooklm_source)
                : stagedFiles;

            if (visible.length === 0) {
                filesList.innerHTML = `<div style="padding:28px; text-align:center; color:#5f7b83; font-size:11px;">No deliverables matching filter '${currentTab.toUpperCase()}'.</div>`;
                return;
            }

            filesList.innerHTML = visible.map(file => `
                <div class="file-row" data-fname="${file.filename}">
                    <button type="button" class="check-box ${file.checked ? 'checked' : ''}" data-fname="${file.filename}" aria-label="Toggle ${file.filename}">
                        ${file.checked ? `
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        ` : ''}
                    </button>
                    <div class="file-type">${getFileBadgeType(file.extension)}</div>
                    <div class="file-name">
                        <b title="${file.filename}">${file.filename}</b>
                        <span>${file.mtime_relative} · ${file.size_human}</span>
                    </div>
                    <span class="file-size">${file.size_human}</span>
                    <span class="pristine-badge ${file.is_notebooklm_source ? '' : 'clutter'}">
                        <span></span> ${file.is_notebooklm_source ? 'PRISTINE' : 'CLUTTER'}
                    </span>
                </div>
            `).join('');

            // Click listeners for row / checkbox
            filesList.querySelectorAll('.file-row').forEach(row => {
                row.addEventListener('click', (e) => {
                    const fname = row.dataset.fname;
                    const fileObj = stagedFiles.find(f => f.filename === fname);
                    if (fileObj) {
                        fileObj.checked = !fileObj.checked;
                        const chk = row.querySelector('.check-box');
                        chk.classList.toggle('checked', fileObj.checked);
                        chk.innerHTML = fileObj.checked ? `
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        ` : '';
                        updateSelectionMeta();
                    }
                });
            });
        }

        function updateSelectionMeta() {
            const selectedFiles = stagedFiles.filter(f => f.checked);
            selectedCountText.textContent = `${selectedFiles.length} OF ${stagedFiles.length} SELECTED`;
            queueSizeText.textContent = `${selectedFiles.length} OBJECTS`;
            statPacketsStaged.textContent = String(selectedFiles.length).padStart(3, '0');
            updateHeroButton();
        }

        function updateHeroButton() {
            if (isSyncing) return;
            const env = envelopes.find(e => e.key === activeEnvelope);
            const envName = env ? env.name.toUpperCase() : activeEnvelope.toUpperCase();
            const selectedCount = stagedFiles.filter(f => f.checked).length;

            if (isDryRun) {
                btnHeroText.textContent = `SIMULATE SYNC // ${envName}`;
                btnHeroSync.disabled = false;
            } else if (isCleanMode) {
                btnHeroText.textContent = `ENGAGE QUANTUM SYNC // ${envName}`;
                btnHeroSync.disabled = false;
            } else {
                if (selectedCount > 0) {
                    btnHeroText.textContent = `TRANSMIT ${selectedCount} VECTORS TO DRIVE NOW`;
                    btnHeroSync.disabled = false;
                } else {
                    btnHeroText.textContent = `SELECT VECTORS TO TRANSMIT`;
                    btnHeroSync.disabled = true;
                }
            }
        }

        // Selection Actions
        btnSelectAll.addEventListener('click', () => {
            const visible = currentTab === 'pristine'
                ? stagedFiles.filter(f => f.is_notebooklm_source)
                : stagedFiles;
            visible.forEach(f => f.checked = true);
            renderFiles();
            updateSelectionMeta();
        });

        btnInvert.addEventListener('click', () => {
            const visible = currentTab === 'pristine'
                ? stagedFiles.filter(f => f.is_notebooklm_source)
                : stagedFiles;
            visible.forEach(f => f.checked = !f.checked);
            renderFiles();
            updateSelectionMeta();
        });

        // Purge Clutter
        btnPurgeClutter.addEventListener('click', async () => {
            const env = envelopes.find(e => e.key === activeEnvelope);
            const envName = env ? env.name : activeEnvelope;
            if (!confirm(`Purge all non-source clutter (.png, .html, etc.) from ${envName}?`)) return;

            appendLog('WAIT', `initiating clutter purge for [${envName}]...`);
            try {
                const res = await fetch('/api/sync/prune-clutter', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ envelope: activeEnvelope })
                });
                const data = await res.json();
                if (data.status === 'success') {
                    appendLog('OK', `purge complete: purged ${data.count} clutter objects`);
                    await fetchEnvelopes();
                    await fetchInventory();
                } else {
                    appendLog('ERR', `purge failed: ${data.message || 'unknown error'}`);
                }
            } catch (err) {
                appendLog('ERR', `purge network error: ${err.message}`);
            }
        });

        // Pull Drive Inbox Trigger
        btnPullDrive.addEventListener('click', async () => {
            appendLog('WAIT', 'dispatched drive inbox pull request via tool #50...');
            btnPullDrive.disabled = true;
            try {
                const res = await fetch('/api/drive/sync-inbox', { method: 'POST' });
                const data = await res.json();
                appendLog('OK', `drive inbox bridge triggered: ${data.message || 'success'}`);
            } catch (err) {
                appendLog('ERR', `drive bridge error: ${err.message}`);
            } finally {
                setTimeout(() => { btnPullDrive.disabled = false; }, 3000);
            }
        });

        // Append log line in CRT terminal
        function appendLog(level, message) {
            const now = new Date();
            const timeStr = now.toISOString().slice(11, 19) + '.' + String(now.getMilliseconds()).padStart(3, '0');
            const row = document.createElement('div');
            row.className = 'log-line';
            row.innerHTML = `
                <span class="log-time">${timeStr}</span>
                <span class="log-level ${level.toLowerCase()}">${level}</span>
                <span>${message}</span>
            `;
            const cursorLine = termBody.querySelector('.cursor-line');
            if (cursorLine) {
                termBody.insertBefore(row, cursorLine);
            } else {
                termBody.appendChild(row);
            }
            termBody.scrollTop = termBody.scrollHeight;
        }

        // 3. Engage Quantum Sync Dispatch
        btnHeroSync.addEventListener('click', async () => {
            const env = envelopes.find(e => e.key === activeEnvelope);
            const envName = env ? env.name : activeEnvelope;
            const selectedFiles = stagedFiles.filter(f => f.checked).map(f => f.filename);

            if (!isCleanMode && selectedFiles.length === 0) {
                appendLog('WAIT', 'cannot execute sync: zero vectors selected');
                return;
            }

            isSyncing = true;
            btnHeroSync.disabled = true;
            btnHeroSync.classList.add('syncing');
            btnEngageIcon.innerHTML = `
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin">
                    <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                    <path d="M12 2a10 10 0 0 1 10 10"></path>
                </svg>
            `;
            btnHeroText.textContent = isDryRun 
                ? 'SIMULATION IN PROGRESS // COMPUTING DIFF...' 
                : 'QUANTUM SYNC IN PROGRESS // UPLINK ACTIVE';

            appendLog('LINK', `initiating transmission for vector [${envName}]...`);
            if (isCleanMode) appendLog('INFO', 'clean source mode: whitelisting (*.md, *.pdf, *.txt) & enforcing --delete-excluded');
            if (isDryRun) appendLog('WAIT', 'dry-run simulation: zero destructive mutations');

            try {
                const res = await fetch('/api/sync/execute', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        envelope: activeEnvelope,
                        clean_mode: isCleanMode,
                        dry_run: isDryRun,
                        selected_files: selectedFiles
                    })
                });
                const data = await res.json();
                if (data.status === 'dispatched') {
                    currentTaskId = data.task_id;
                    appendLog('OK', `task token assigned: ${currentTaskId}`);
                    listenTelemetry(currentTaskId);
                } else {
                    appendLog('ERR', `dispatch rejected: ${data.message || 'error'}`);
                    resetSyncState();
                }
            } catch (err) {
                appendLog('ERR', `quantum transmission failed: ${err.message}`);
                resetSyncState();
            }
        });

        function listenTelemetry(taskId) {
            if (eventSource) eventSource.close();
            eventSource = new EventSource(`/api/sync/stream/${taskId}`);

            eventSource.addEventListener('start', (e) => {
                const p = JSON.parse(e.data);
                appendLog('LINK', `rclone worker spawned across ${p.remotes.join(', ')}`);
            });

            eventSource.addEventListener('log', (e) => {
                const p = JSON.parse(e.data);
                appendLog('INFO', p.line);
            });

            eventSource.addEventListener('progress', (e) => {
                const p = JSON.parse(e.data);
                appendLog('OK', p.raw);
            });

            eventSource.addEventListener('complete', (e) => {
                const p = JSON.parse(e.data);
                if (p.status === 'SUCCESS') {
                    appendLog('OK', `TRANSMISSION SUCCESSFUL // DURATION: ${p.duration_seconds}s`);
                } else {
                    appendLog('ERR', `TRANSMISSION TERMINATED: ${p.status}`);
                }
                eventSource.close();
                resetSyncState();
                fetchEnvelopes();
            });

            eventSource.onerror = () => {
                appendLog('ERR', 'telemetry stream closed');
                if (eventSource) eventSource.close();
                resetSyncState();
            };
        }

        function resetSyncState() {
            isSyncing = false;
            btnHeroSync.disabled = false;
            btnHeroSync.classList.remove('syncing');
            btnEngageIcon.innerHTML = `
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
            `;
            updateHeroButton();
        }

        // Initialize on Load
        document.addEventListener('DOMContentLoaded', () => {
            fetchEnvelopes();
        });
    </script>
</body>
</html>"""


