      background-color: #090A0F !important;
      background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(6, 182, 212, 0.08) 0%, rgba(8, 145, 178, 0.02) 45%, rgba(9, 10, 15, 0) 75%), #090A0F !important;
      color: #F2F4F7 !important;
