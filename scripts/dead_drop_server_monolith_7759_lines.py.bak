        <span>JIT Approvals</span>
        <span id="pill-jit-count" class="px-1.5 py-0.5 rounded-[2px] text-[9px] font-mono bg-amber-950 text-amber-300 border border-amber-800/40">2</span>
      </button>
      <button onclick="switchTab('tab-queue')" id="btn-queue" class="tab-btn px-3 py-1.5 rounded-[2px] text-xs font-mono font-medium uppercase tracking-wider text-slate-400 hover:text-white hover:bg-[#1E2330] transition flex items-center gap-1.5 border border-transparent">
        <span>Active Queue</span>
        <span id="pill-queue-badge" class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
      </button>
      <button onclick="switchTab('tab-cmdb')" id="btn-cmdb" class="tab-btn px-3 py-1.5 rounded-[2px] text-xs font-mono font-medium uppercase tracking-wider text-slate-400 hover:text-white hover:bg-[#1E2330] transition flex items-center gap-1.5 border border-transparent">
        <span>Fleet &amp; CMDB</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
      </button>
      <button onclick="switchTab('tab-horizon')" id="btn-horizon" class="tab-btn px-3 py-1.5 rounded-[2px] text-xs font-mono font-medium uppercase tracking-wider text-slate-400 hover:text-white hover:bg-[#1E2330] transition flex items-center gap-1.5 border border-transparent">
        <span>Horizon Telemetry</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#06B6D4]"></span>
      </button>
      <button onclick="switchTab('tab-predict')" id="btn-predict" class="tab-btn px-3 py-1.5 rounded-[2px] text-xs font-mono font-medium uppercase tracking-wider text-slate-400 hover:text-white hover:bg-[#1E2330] transition flex items-center gap-1.5 border border-transparent">
        <span>Sickos Exchange</span>
