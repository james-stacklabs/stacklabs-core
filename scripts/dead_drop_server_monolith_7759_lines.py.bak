      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      font-weight: 500 !important;
      letter-spacing: -0.03em !important;
    }
    .font-metrics, .font-mono {
      font-family: 'JetBrains Mono', monospace !important;
    }
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: var(--bg-canvas); }
    ::-webkit-scrollbar-thumb { background: var(--border-card); border-radius: 2px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--color-teal); }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    /* Flat Black Material Card Standard */
    .material-card {
      border-radius: 2px !important;
      background-color: #0B0D13 !important;
      border-top: 1px solid #1E2330 !important;
      border-bottom: 1px solid #1E2330 !important;
      border-right: 1px solid #1E2330 !important;
      border-left: 6px solid #06B6D4 !important;
