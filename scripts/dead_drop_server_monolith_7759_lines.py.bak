                <span class="text-slate-200 truncate flex items-center gap-1.5 font-medium">
                  <span>${e.icon}</span>
                  <span>${escapeHtml(e.name)}</span>
                </span>
                <span class="text-[9px] font-metrics text-slate-400 pl-5">Modified: ${e.last_modified || 'Recently'}</span>
              </div>
              <div class="flex flex-col items-end shrink-0">
                <span class="text-[10px] font-metrics text-emerald-400 font-bold">Ready (${e.pristine_files || 0})</span>
                <span class="text-[9px] font-metrics text-slate-500">${e.total_size_human || ''}</span>
              </div>
            </div>
          `).join('');
        }
        const dedicatedList = document.getElementById('dedicated-sync-envelopes');
        if (dedicatedList) {
          dedicatedList.innerHTML = envs.map(e => `
            <div class="p-3 rounded-[2px] bg-[#0B0D13] border border-[#1E2330] flex items-center justify-between">
              <div class="flex flex-col">
                <div class="text-xs font-bold text-white flex items-center gap-2">
                  <span>${e.icon}</span>
                  <span>${escapeHtml(e.name)}</span>
                  <span class="text-[10px] font-metrics px-1.5 py-0.2 rounded bg-[#141B26] border border-[#1E2330] text-slate-400">${e.id}</span>
                </div>
                <div class="text-[11px] text-slate-400 mt-0.5">${escapeHtml(e.description || '')}</div>
                <div class="text-[10px] font-metrics text-amber-400/80 mt-1">Last Modified: ${e.last_modified || 'Recently'}</div>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-[11px] font-metrics text-emerald-400">${e.pristine_files || 0} files • ${e.total_size_human || '0 KB'}</span>
                <button onclick="triggerSyncSingle('${e.key}')" class="px-3 py-1 bg-amber-500 hover:bg-amber-400 text-black font-bold text-xs rounded transition">
                  Sync
                </button>
              </div>
            </div>
          `).join('');
        }
      } catch (err) {
        console.error('Fetch envelopes error:', err);
      }
    }
    // Trigger sync single
    async function triggerSyncSingle(key) {
      showToast(`Initiating sync for ${key}...`);
      try {
        const res = await fetch('/api/sync/execute', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ envelope: key })
        });
        const data = await res.json();
        showToast(`Sync dispatched: ${key}`);
      } catch (err) {
        showToast(`Sync failed: ${err.message}`, true);
      }
    }
    // Trigger sync all
    async function triggerSyncAll() {
      const btn = document.getElementById('hero-sync-btn');
      const label = document.getElementById('hero-sync-label');
      const icon = document.getElementById('hero-sync-icon');
      if (btn) btn.disabled = true;
      if (label) label.textContent = 'DISPATCHING SYNC...';
      if (icon) icon.className = 'animate-spin';
      try {
        const res = await fetch('/api/sync/execute', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ envelope: 'ALL', sync_all: true })
        });
        const data = await res.json();
        showToast('🚀 Full Sovereign Drive Sync dispatched to Google Drive');
        if (label) label.textContent = 'SYNC DISPATCHED ✓';
        setTimeout(() => {
          if (btn) btn.disabled = false;
          if (label) label.textContent = 'SYNC ALL ENVELOPES TO GOOGLE DRIVE';
          if (icon) icon.className = '';
        }, 4000);
      } catch (err) {
        showToast('Sync failed: ' + err.message, true);
        if (btn) btn.disabled = false;
        if (label) label.textContent = 'SYNC ALL ENVELOPES TO GOOGLE DRIVE';
        if (icon) icon.className = '';
      }
    }
    function checkAndRenderEmptyApprovals(container) {
      if (!container) return;
      const cards = container.querySelectorAll('.jit-card, [data-approval-id], .bg-\\[\\#151D2C\\]');
      if (cards.length === 0) {
        container.innerHTML = `
          <div class="p-6 bg-[#0B0F17] border border-[#1E2533] rounded-[2px] text-center flex flex-col items-center justify-center gap-2">
            <div class="text-sm font-bold text-emerald-400">✨ All Clear — No Pending Approvals</div>
            <div class="text-[11px] font-metrics text-slate-500">All architectural gates satisfied. Inbox cleared.</div>
          </div>
        `;
      }
    }
    function updateJitCounts() {
      const cards = document.querySelectorAll('#mission-jit-cards-container .jit-card, #mission-jit-cards-container [data-approval-id], #mission-jit-cards-container .bg-\\[\\#151D2C\\]');
      const count = cards.length;
      const pillCount = document.getElementById('pill-jit-count');
      const mPillCount = document.getElementById('m-pill-jit-count');
      const statJit = document.getElementById('stat-jit-val');
      if (pillCount) pillCount.textContent = count;
      if (mPillCount) mPillCount.textContent = count;
      if (statJit) statJit.textContent = count > 0 ? `${count} Awaiting` : '0 Awaiting';
    }
    // Fetch JIT Approvals
    async function fetchApprovals() {
      try {
        const res = await fetch('/api/cockpit/approvals');
        if (!res.ok) return;
        const data = await res.json();
        const approvals = data.approvals || [];
        const pillCount = document.getElementById('pill-jit-count');
        const mPillCount = document.getElementById('m-pill-jit-count');
        const statJit = document.getElementById('stat-jit-val');
        if (pillCount) pillCount.textContent = approvals.length || '0';
        if (mPillCount) mPillCount.textContent = approvals.length || '0';
        if (statJit) statJit.textContent = approvals.length > 0 ? `${approvals.length} Awaiting` : '0 Awaiting';
        // If live approvals exist, update cards
        const container = document.getElementById('mission-jit-cards-container');
        if (container) {
          if (approvals.length === 0) {
            checkAndRenderEmptyApprovals(container);
          } else {
            container.innerHTML = approvals.slice(0, 2).map(appr => `
              <div class="bg-[#0B0D13] border border-[#1E2330] rounded-[2px] p-3 flex flex-col gap-2.5 jit-card" id="card-${appr.sys_id}" data-approval-id="${appr.sys_id}">
                <div class="flex items-center justify-between">
                  <span class="px-2 py-0.5 rounded text-[10px] font-metrics font-bold bg-amber-950 text-amber-300 border border-amber-800/50">${appr.is_challenge ? 'CHALLENGE' : 'APPROVAL'} // ${escapeHtml(appr.task_id || appr.sys_id)}</span>
                  <span class="text-[10px] font-metrics text-slate-400">${escapeHtml(appr.auth_level || 'OMEGA=1')}</span>
                </div>
                <div>
                  <h3 class="text-xs font-bold text-white">${escapeHtml(appr.title || appr.task_id)}</h3>
                  <p class="text-[11px] text-slate-400 mt-0.5">${escapeHtml((appr.plan_markdown || appr.description || 'Pending architectural verification').slice(0, 80))}...</p>
                </div>
                <div class="flex items-center justify-between text-[10px] font-metrics text-slate-400 bg-[#07090E] px-2 py-1 rounded border border-[#1E2330]">
                  <span>Created: <strong class="text-slate-200">${formatDateTime(appr.sys_created_on)}</strong></span>
                  <span>Updated: <strong class="text-slate-200">${formatDateTime(appr.sys_updated_on || appr.sys_created_on)}</strong></span>
                </div>
                <div class="flex items-center gap-2 pt-1 border-t border-[#1E2330]">
                  <button onclick="handleApproval('${appr.sys_id}', 'authorize', this)" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs py-1.5 rounded transition">
                    ✓ Authorize
                  </button>
                  <button onclick="handleApproval('${appr.sys_id}', 'archive', this)" class="px-3 bg-[#141B26] hover:bg-[#1E2330] text-slate-300 text-xs py-1.5 rounded border border-[#1E2330] transition">
                    Archive
                  </button>
                </div>
              </div>
            `).join('');
          }
        }
        // Dedicated Tab List
        const dedicatedList = document.getElementById('dedicated-jit-list');
        if (dedicatedList) {
          if (approvals.length === 0) {
            checkAndRenderEmptyApprovals(dedicatedList);
          } else {
            dedicatedList.innerHTML = approvals.map(appr => `
              <div class="p-3 bg-[#0B0D13] border border-[#1E2330] rounded-[2px] flex flex-col gap-2 jit-card" id="card-ded-${appr.sys_id}" data-approval-id="${appr.sys_id}">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold text-amber-300">${escapeHtml(appr.task_id || appr.sys_id)}</span>
                  <span class="text-[10px] font-metrics text-emerald-400">${appr.state || 'Pending'}</span>
                </div>
                <div class="text-xs font-bold text-white">${escapeHtml(appr.title || '')}</div>
                <div class="flex items-center gap-4 text-[10px] font-metrics text-slate-400">
                  <span>Created: <strong class="text-slate-200">${formatDateTime(appr.sys_created_on)}</strong></span>
                  <span>Updated: <strong class="text-slate-200">${formatDateTime(appr.sys_updated_on || appr.sys_created_on)}</strong></span>
                </div>
                <div class="flex items-center gap-2 mt-1">
                  <button onclick="handleApproval('${appr.sys_id}', 'authorize', this)" class="px-4 py-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded transition">
                    ✓ Authorize
                  </button>
                  <button onclick="handleApproval('${appr.sys_id}', 'archive', this)" class="px-3 py-1 bg-[#141B26] hover:bg-[#1E2330] text-slate-300 text-xs rounded border border-[#1E2330] transition">
                    Archive
                  </button>
                </div>
              </div>
            `).join('');
          }
        }
      } catch (err) {
        console.error('Fetch approvals error:', err);
      }
    }
    // Handle JIT Approval Action
    async function handleApproval(arg1, arg2, arg3) {
      let cardId = null;
      let sysId = null;
      let action = null;
      let btn = null;
      let card = null;
      if (typeof arg3 === 'string') {
        // Signature: handleApproval(cardId, approvalId, action)
        cardId = arg1;
        sysId = arg2;
        action = arg3;
        card = document.getElementById(cardId) || (typeof cardId === 'string' && cardId.startsWith('#') ? document.querySelector(cardId) : null);
        if (card) {
          btn = card.querySelector(`button[onclick*="'${action}'"]`) || card.querySelector('button');
        }
      } else {
        // Signature: handleApproval(sysId, action, btn)
        sysId = arg1;
        action = arg2;
        btn = arg3;
        if (btn && btn.nodeType) {
          card = btn.closest('.jit-card') || btn.closest('.bg-\\[\\#151D2C\\]') || btn.closest('#mission-jit-cards-container > div, #dedicated-jit-list > div') || btn.parentElement?.parentElement;
        }
      }
      if (!card && sysId) {
        card = document.getElementById('card-' + sysId) || document.getElementById('card-ded-' + sysId) || document.querySelector(`[data-approval-id="${sysId}"]`);
      }
      if (!btn && card) {
        btn = card.querySelector('button');
      }
      const origText = btn ? btn.textContent : '';
      if (btn) {
        btn.disabled = true;
        btn.textContent = '...';
      }
      try {
        const res = await fetch(`/api/cockpit/approvals/${encodeURIComponent(sysId)}/${encodeURIComponent(action)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }
        const result = await res.json();
        const isAuth = (action.toLowerCase() === 'authorize' || action.toLowerCase() === 'approve');
        if (btn) {
          btn.textContent = isAuth ? '✓ Authorized' : '✗ Rejected';
          btn.className = isAuth
            ? 'flex-1 bg-emerald-900/80 text-emerald-300 font-bold text-xs py-1.5 rounded border border-emerald-700/50 cursor-default'
            : 'flex-1 bg-red-950/80 text-red-300 font-bold text-xs py-1.5 rounded border border-red-800/50 cursor-default';
          if (btn.parentElement) {
            btn.parentElement.querySelectorAll('button').forEach(b => {
              if (b !== btn) b.style.display = 'none';
            });
          }
        }
        showToast(isAuth ? `Omega=1 Authorized: ${sysId}` : `Rejected: ${sysId}`);
        // 600ms success acknowledgement
        await new Promise(r => setTimeout(r, 600));
        // Locate all matching cards for this sysId (e.g. Mission deck & dedicated list)
        const cardsToDismiss = new Set();
        if (card) cardsToDismiss.add(card);
        if (sysId) {
          document.querySelectorAll(`[data-approval-id="${sysId}"], #card-${sysId}, #card-ded-${sysId}`).forEach(el => cardsToDismiss.add(el));
        }
        cardsToDismiss.forEach(el => {
          el.style.maxHeight = el.scrollHeight + 'px';
          el.offsetHeight; // trigger reflow
          el.style.transition = 'all 0.4s ease-out';
          el.style.opacity = '0';
          el.style.transform = 'translateY(-10px)';
          el.style.maxHeight = '0';
          el.style.marginBottom = '0';
          el.style.paddingTop = '0';
          el.style.paddingBottom = '0';
          el.style.borderWidth = '0';
          el.style.overflow = 'hidden';
        });
        setTimeout(() => {
          cardsToDismiss.forEach(el => el.remove());
          checkAndRenderEmptyApprovals(document.getElementById('mission-jit-cards-container'));
          checkAndRenderEmptyApprovals(document.getElementById('dedicated-jit-list'));
          updateJitCounts();
        }, 400);
      } catch (err) {
        if (btn) {
          btn.textContent = origText;
          btn.disabled = false;
        }
        showToast('Action failed: ' + err.message, true);
      }
    }
    // Live Queue Telemetry Polling (every 5 seconds)
    async function fetchQueueTelemetry() {
      try {
        const res = await fetch('/api/cockpit/queue');
        if (!res.ok) return;
        const data = await res.json();
        // Quick Stats Ribbon
        const statQueue = document.getElementById('stat-queue-val');
        const statAtf = document.getElementById('stat-atf-val');
        if (statQueue) {
          if (data.processing_ticket) {
            const raw = data.processing_ticket.replace('.md', '');
            const m = raw.match(/^(WO\d+)/i);
            statQueue.textContent = m ? m[1] : (raw.length > 14 ? raw.slice(0, 14) + '...' : raw);
            statQueue.title = raw;
          } else {
            statQueue.textContent = 'IDLE';
          }
        }
        if (statAtf) {
          statAtf.textContent = `ATF ${data.atf_status}`;
          statAtf.className = data.atf_status === 'PASSED' ? 'text-[10px] font-metrics text-emerald-400' : 'text-[10px] font-metrics text-amber-400';
        }
        // Mission Deck HUD Ticker
        const hudTicket = document.getElementById('mission-hud-ticket');
        const hudDetail = document.getElementById('mission-hud-detail');
        if (hudTicket) {
          if (data.processing_ticket) {
            hudTicket.textContent = 'EXECUTING: ' + data.processing_ticket.replace('.md', '');
            hudTicket.className = 'text-amber-400 font-bold';
          } else if (data.recent_archive && data.recent_archive.length > 0) {
            hudTicket.textContent = data.recent_archive[0].replace('.md', '') + ' RESOLVED';
            hudTicket.className = 'text-emerald-400 font-bold';
          } else {
            hudTicket.textContent = 'RUNNER IDLE';
            hudTicket.className = 'text-slate-400 font-bold';
          }
        }
        if (hudDetail) {
          hudDetail.textContent = `Incoming: ${data.incoming_count} • ATF: ${data.atf_status} • Recent Archives: ${data.recent_archive ? data.recent_archive.length : 0}`;
        }
        // Dedicated Tab
        const qInc = document.getElementById('queue-incoming-count');
        const qProc = document.getElementById('queue-processing-ticket');
        const qAtf = document.getElementById('queue-atf-badge');
        const qArch = document.getElementById('queue-archive-list');
        if (qInc) qInc.textContent = `${data.incoming_count} tickets`;
        if (qProc) qProc.textContent = data.processing_ticket || 'NONE (IDLE)';
        if (qAtf) {
          qAtf.textContent = data.atf_status;
          qAtf.className = data.atf_status === 'PASSED' ? 'text-sm font-metrics font-bold text-emerald-400 mt-2' : 'text-sm font-metrics font-bold text-amber-400 mt-2';
        }
        if (qArch && data.recent_archive) {
          qArch.innerHTML = data.recent_archive.map(name => `
            <div class="p-2 rounded bg-[#0B0D13] border border-[#1E2330] flex items-center justify-between">
              <span class="truncate text-slate-200">${escapeHtml(name)}</span>
              <span class="text-[10px] text-emerald-400 shrink-0">ARCHIVED</span>
            </div>
          `).join('');
        }
      } catch (err) {
        console.error('Queue telemetry poll error:', err);
      }
    }
    async function emergencyKillRunner() {
      if (!confirm("⚠️ EMERGENCY KILL SWITCH:\nAre you sure you want to kill the active runner? This will terminate running agy processes immediately and quarantine the active ticket.")) {
        return;
      }
      const btn = document.getElementById('btn-kill-runner');
      const originalHtml = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span>⚡</span><span>Killing runner...</span>';
      }
      try {
        const res = await fetch('/api/cockpit/kill_runner', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (res.ok && data.status === 'success') {
          showToast(data.message || 'Runner killed successfully', false);
          if (typeof fetchQueueTelemetry === 'function') fetchQueueTelemetry();
          if (typeof fetchQueue === 'function') fetchQueue();
        } else {
          showToast('Kill failed: ' + (data.message || 'Server error'), true);
        }
      } catch (err) {
        showToast('Network error triggering kill switch: ' + err.message, true);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      }
    }
    // Fetch and render Fleet & CMDB Lite telemetry
    async function loadCmdbLite() {
      try {
        const res = await fetch('/api/cockpit/cmdb_lite');
        if (!res.ok) return;
        const data = await res.json();
        // 1. Clio Vitals
        const h = data.clio_health || {};
        const cpuTempEl = document.getElementById('clio-cpu-temp');
        if (cpuTempEl) cpuTempEl.textContent = h.cpu_temp || '--';
        const pwrEl = document.getElementById('clio-power-draw');
        if (pwrEl) pwrEl.textContent = h.power_draw || '--';
        const ramStatEl = document.getElementById('clio-ram-stat');
        if (ramStatEl) ramStatEl.textContent = `${h.ram_used_gb || 0} / ${h.ram_total_gb || 0} GB`;
        const ramPctEl = document.getElementById('clio-ram-percent');
        if (ramPctEl) ramPctEl.textContent = `${h.ram_percent || 0}% used`;
        const loadEl = document.getElementById('clio-load-avg');
        if (loadEl && h.load_avg) loadEl.textContent = h.load_avg.join(' • ');
        const ramBar = document.getElementById('clio-ram-bar');
        if (ramBar) ramBar.style.width = `${Math.min(100, Math.max(5, h.ram_percent || 0))}%`;
        const ramLbl = document.getElementById('clio-ram-label');
        if (ramLbl && h.ram_total_gb && h.ram_used_gb) {
          const freeGb = (h.ram_total_gb - h.ram_used_gb).toFixed(1);
          ramLbl.textContent = `Available: ${freeGb} GB headroom`;
        }
        // 2. Active Daemons
        const daemonContainer = document.getElementById('daemons-list-container');
        if (daemonContainer && data.processes) {
          daemonContainer.innerHTML = data.processes.map(p => {
            const isActive = p.status === 'ACTIVE';
            return `
              <div class="p-2.5 rounded-[2px] bg-[#0B0D13] border border-[#1E2330] flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full ${isActive ? 'bg-emerald-400 animate-pulse' : 'bg-amber-500'}"></span>
                  <div>
                    <div class="text-xs font-bold text-slate-200">${escapeHtml(p.label)}</div>
                    <div class="text-[10px] font-metrics text-slate-500">${escapeHtml(p.name)}.py ${p.port ? `• Port :${p.port}` : ''}</div>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded text-[10px] font-metrics font-bold ${isActive ? 'bg-emerald-950 text-emerald-400 border border-emerald-800/40' : 'bg-amber-950 text-amber-400 border border-amber-800/40'}">
                  ${p.status}
                </span>
              </div>
            `;
          }).join('');
        }
        // 3. Fleet Hardware Nodes
        const nodesGrid = document.getElementById('cmdb-nodes-grid');
        const nodesCount = document.getElementById('cmdb-nodes-count');
        if (nodesCount && data.nodes) {
          nodesCount.textContent = `${data.nodes.length} CIs in Ledger`;
        }
        if (nodesGrid && data.nodes) {
          const coreOrder = ['clio', 'pegasus', 'argo', 'artemis', 'pi_zero_fleet'];
          const sortedNodes = [...data.nodes].sort((a, b) => {
            const idxA = coreOrder.indexOf(a.name);
            const idxB = coreOrder.indexOf(b.name);
            if (idxA !== -1 && idxB !== -1) return idxA - idxB;
            if (idxA !== -1) return -1;
            if (idxB !== -1) return 1;
            return a.name.localeCompare(b.name);
          });
          nodesGrid.innerHTML = sortedNodes.slice(0, 9).map(n => {
            const isClio = n.name === 'clio';
            const isPegasus = n.name === 'pegasus';
            const isArgo = n.name === 'argo';
            const isArtemis = n.name === 'artemis';
            const isPiFleet = n.name === 'pi_zero_fleet';
            let roleBadge = 'Sentinel Node';
            if (isClio) roleBadge = 'Living Room Forge Master';
            else if (isPegasus) roleBadge = 'Visual Sentry / Bedroom Cockpit';
            else if (isArgo) roleBadge = 'Hailo-8L AI Sensor Sentry';
            else if (isArtemis) roleBadge = 'Mobile Laptop Cockpit';
            else if (isPiFleet) roleBadge = 'Distributed Zero 2 W Cluster';
            const borderClass = isClio ? 'border-[#1E2330] border-l-2 border-l-amber-500 bg-[#0B0D13]' : 'border-[#1E2330] border-l-2 border-l-cyan-500 bg-[#0B0D13]';
            const nameColor = isClio ? 'text-amber-400' : 'text-white';
            return `
              <div class="p-3 rounded-[2px] border ${borderClass} flex flex-col justify-between gap-2 shadow">
                <div class="flex items-start justify-between gap-1">
                  <div>
                    <div class="flex items-center gap-1.5">
                      <span class="text-xs font-bold font-metrics uppercase ${nameColor}">${escapeHtml(n.name)}</span>
                      ${isClio ? '<span class="px-1.5 py-0.2 rounded text-[8px] font-metrics font-bold bg-amber-500 text-black">HOST</span>' : ''}
                    </div>
                    <div class="text-[10px] text-slate-400 font-sans line-clamp-1 mt-0.5" title="${escapeHtml(n.short_description || '')}">
                      ${escapeHtml(n.model_id || n.short_description || 'Node CI')}
                    </div>
                  </div>
                  <span class="px-1.5 py-0.5 rounded text-[9px] font-metrics bg-emerald-950/80 text-emerald-400 border border-emerald-800/40">ONLINE</span>
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-[#1E2330] text-[10px] font-metrics text-slate-400">
                  <span>${escapeHtml(roleBadge)}</span>
                  <span class="text-slate-300 font-mono">${escapeHtml(n.ip_address || 'Cluster')}</span>
                </div>
              </div>
            `;
          }).join('');
        }
        // 4. Live Deployments
        const depContainer = document.getElementById('deployments-list-container');
        if (depContainer && data.deployments) {
          depContainer.innerHTML = data.deployments.map(d => `
            <div class="p-2.5 rounded-[2px] bg-[#0B0D13] border border-[#1E2330] flex items-center justify-between">
              <div>
                <div class="text-xs font-bold text-slate-200">${escapeHtml(d.name)}</div>
                <div class="text-[10px] font-metrics text-slate-500 flex items-center gap-1.5">
                  <span class="text-blue-400">${escapeHtml(d.badge)}</span>
                  <span>•</span>
                  <span class="truncate max-w-[200px] text-slate-400">${escapeHtml(d.url)}</span>
                </div>
              </div>
              <a href="${escapeHtml(d.url)}" target="_blank" rel="noopener noreferrer" class="px-3 py-1 bg-[#141B26] hover:bg-[#1E2330] text-amber-300 hover:text-amber-200 text-xs font-metrics font-bold rounded border border-[#1E2330] transition flex items-center gap-1">
                <span>Open</span>
                <span>↗</span>
              </a>
            </div>
          `).join('');
        }
        // 5. Prospectus Vaults
        const prosContainer = document.getElementById('prospectus-list-container');
        if (prosContainer && data.prospectuses) {
          prosContainer.innerHTML = data.prospectuses.map(p => `
            <div class="p-2.5 rounded-[2px] bg-[#0B0D13] border border-[#1E2330] flex items-center justify-between">
              <div>
                <div class="text-xs font-bold text-slate-200">${escapeHtml(p.title)}</div>
                <div class="text-[10px] font-metrics text-emerald-400">${escapeHtml(p.status)}</div>
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-metrics bg-[#07090E] text-slate-400 border border-[#1E2330] font-mono">
                ${escapeHtml(p.slug.split('_').slice(1).join('_') || p.slug)}
              </span>
            </div>
          `).join('');
        }
        const upEl = document.getElementById('cmdb-last-updated');
        if (upEl) {
          const now = new Date();
          upEl.textContent = `Updated ${now.toLocaleTimeString()}`;
        }
      } catch (err) {
        console.error('Error loading CMDB Lite:', err);
      }
    }
    // =========================================================================
    // SOVEREIGN HORIZON BIT-PERFECT EVIDENCE DRAWER (INVARIANT 41)
    // =========================================================================
    let isEvidenceDrawerOpen = false;
    let currentEvidenceData = {
      doc_id: 'DOC_SEC_INDENTURE',
      title: 'Senior Secured Indenture Agreement (Section 6.01 - Events of Default)',
      citation: 'SEC Form 8-K // Exhibit 4.1 // Lines 42-48',
      offsets: [142, 401],
      byte_count: 259,
      sha256: '5c09b77cd3cae07abfe4b6848fcb2c730e18ee77e1e69b0fa6db0195ecf1d141',
      verbatim_text: '(a) fails to pay any installment of interest on the Senior Secured Notes when due, and such failure continues for a period of 30 days; and\n(b) fails to pay the principal of, or premium, if any, on the Notes when due at maturity, upon redemption, or otherwise;',
      recitation_risk: '0.0% (Zero LLM tokens generated)',
      target_phrase: 'fails to pay any installment of interest'
    };
    function handleDrawerClick(e) {
      if (e.target.closest('#close-evidence-drawer') || e.target.closest('#copy-citation-btn') || e.target.closest('button')) {
        return;
      }
      if (!isEvidenceDrawerOpen) {
        openEvidenceDrawer('DOC_SEC_INDENTURE', 142, 401);
      }
    }
    async function openEvidenceDrawer(docId = 'DOC_SEC_INDENTURE', startOffset = 142, endOffset = 401) {
      isEvidenceDrawerOpen = true;
      const drawer = document.getElementById('horizon-evidence-drawer');
      const backdrop = document.getElementById('horizon-drawer-backdrop');
      if (drawer) {
        drawer.classList.remove('translate-x-[calc(100%-36px)]', 'translate-x-full');
        drawer.classList.add('translate-x-0');
      }
      if (backdrop) {
        backdrop.classList.remove('hidden');
      }
      try {
        const resp = await fetch(`/api/horizon/evidence/${encodeURIComponent(docId)}?start=${startOffset}&end=${endOffset}`);
        if (resp.ok) {
          const data = await resp.json();
          currentEvidenceData = data;
          renderEvidenceDrawer(data);
        }
      } catch (err) {
        console.error('Error fetching evidence:', err);
      }
    }
    function renderEvidenceDrawer(data) {
      const hashPrefix = data.sha256 ? data.sha256.slice(0, 16) : '5c09b77cd3cae07a';
      const badgeEl = document.getElementById('evidence-header-badge');
      if (badgeEl) {
        badgeEl.textContent = `[🔒 VERIFIED ON METAL // SHA-256: ${hashPrefix}... // 0 MUTATIONS]`;
      }
      const citEl = document.getElementById('evidence-citation');
      if (citEl) citEl.textContent = data.citation || 'SEC Form 8-K // Exhibit 4.1 // Lines 42-48';
      const titleEl = document.getElementById('evidence-doc-title');
      if (titleEl) titleEl.textContent = data.title || data.doc_id;
      const byteEl = document.getElementById('evidence-byte-count');
      if (byteEl) byteEl.textContent = `${data.byte_count} B`;
      const offEl = document.getElementById('evidence-offsets');
      if (offEl) offEl.textContent = `Offsets [${data.offsets[0]}, ${data.offsets[1]}]`;
      const recEl = document.getElementById('evidence-recitation-risk');
      if (recEl) recEl.textContent = data.recitation_risk || '0.0%';
      const shaEl = document.getElementById('evidence-full-sha256');
      if (shaEl) shaEl.textContent = data.sha256;
      const container = document.getElementById('evidence-verbatim-container');
      if (container && data.verbatim_text) {
        let text = data.verbatim_text;
        const phrase = data.target_phrase || '';
        if (phrase && text.includes(phrase)) {
          const parts = text.split(phrase);
          container.innerHTML = escapeHtml(parts[0]) + 
            `<mark class="bg-amber-400/20 text-amber-200 border-b border-amber-400 px-0.5 font-bold">${escapeHtml(phrase)}</mark>` + 
            escapeHtml(parts.slice(1).join(phrase));
        } else {
          container.textContent = text;
        }
      }
    }
    function closeEvidenceDrawer() {
      isEvidenceDrawerOpen = false;
      const drawer = document.getElementById('horizon-evidence-drawer');
      const backdrop = document.getElementById('horizon-drawer-backdrop');
      if (drawer) {
        drawer.classList.remove('translate-x-0');
        drawer.classList.add('translate-x-[calc(100%-36px)]');
      }
      if (backdrop) {
        backdrop.classList.add('hidden');
      }
    }
    async function copyAdmissibleCitation() {
      const d = currentEvidenceData;
      const textToCopy = `PRIMARY SOURCE FORENSIC CITATION:
Document: ${d.title || d.doc_id}
Citation: ${d.citation || 'SEC Form 8-K // Exhibit 4.1 // Lines 42-48'}
Offsets: [${d.offsets ? d.offsets.join(', ') : '142, 401'}] | Bytes: ${d.byte_count || 259}
Cryptographic SHA-256: ${d.sha256 || ''}
Provenance: VERIFIED_ON_METAL (Zero LLM Recitation Drift)
VERBATIM PRIMARY SOURCE TEXT:
"${d.verbatim_text || ''}"`;
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(textToCopy);
        } else {
          const ta = document.createElement('textarea');
          ta.value = textToCopy;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        const lbl = document.getElementById('copy-btn-label');
        if (lbl) {
          const original = lbl.textContent;
          lbl.textContent = '✓ Copied to Clipboard!';
          setTimeout(() => { lbl.textContent = original; }, 2000);
        }
        showToast('Court-Admissible Citation copied to clipboard!');
      } catch (err) {
        console.error('Failed to copy citation:', err);
        showToast('Failed to copy to clipboard', true);
      }
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isEvidenceDrawerOpen) {
        closeEvidenceDrawer();
      }
    });
    // =========================================================================
    // DERANGED PREDICT MARKET CLIENT LOGIC
    // =========================================================================
    async function loadPredictMarket() {
      try {
        const res = await fetch('/api/predict/state');
        if (!res.ok) throw new Error('Failed to fetch prediction market state');
        const state = await res.json();
        // 1. Render Advocate Bankrolls Ribbon
        const advRibbon = document.getElementById('cockpit-advocates-ribbon');
        if (advRibbon && state.advocates_bankrolls) {
          advRibbon.innerHTML = Object.entries(state.advocates_bankrolls).map(([k, adv]) => {
            const pnl = adv.profit_loss_cents;
            const isProfit = pnl >= 0;
            const pnlPct = ((pnl / 100000) * 100).toFixed(1);
            return `
              <div class="bg-[#0B0D13] border border-[#1E2330] rounded-[2px] p-3 flex flex-col justify-between shadow">
                <div class="flex items-start justify-between mb-2">
                  <div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-5 h-5 rounded-full bg-[#141B26] border border-[#1E2330] flex items-center justify-center text-[10px] font-extrabold text-slate-300">#${adv.rank}</span>
                      <span class="font-extrabold text-white text-xs truncate max-w-[110px]" title="${escapeHtml(adv.name)}">${escapeHtml(adv.name)}</span>
                    </div>
                    <div class="text-[10px] text-purple-400 font-medium">${escapeHtml(adv.avatar_tag)}</div>
                  </div>
                  <div class="text-[10px] font-bold px-1.5 py-0.5 rounded border ${isProfit ? 'bg-emerald-950/60 border-emerald-700/60 text-emerald-400' : 'bg-rose-950/60 border-rose-700/60 text-rose-400'}">
                    ${isProfit ? '+' : ''}${pnlPct}%
                  </div>
                </div>
                <div class="border-t border-[#1E2330] pt-2 mt-1">
                  <div class="flex justify-between items-baseline mb-1">
                    <span class="text-[10px] text-slate-500 font-sans">NET WORTH</span>
                    <span class="text-sm font-extrabold text-slate-100">$${(adv.portfolio_value_cents / 100).toFixed(2)}</span>
                  </div>
                  <div class="flex justify-between items-baseline mb-2">
                    <span class="text-[10px] text-slate-500 font-sans">FREE CASH</span>
                    <span class="text-xs font-semibold text-slate-400">$${(adv.cash_cents / 100).toFixed(2)}</span>
                  </div>
                  <div class="bg-[#07090E] p-2 rounded border border-[#1E2330] text-[10px] text-amber-300/90 leading-tight">
                    <span class="text-slate-500 block text-[9px] font-bold uppercase mb-0.5 font-sans">Superstition:</span>
                    "${escapeHtml(adv.active_superstition)}"
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }
        // 2. Render Active Contracts Grid
        const contractsGrid = document.getElementById('cockpit-contracts-grid');
        if (contractsGrid && state.contracts) {
          contractsGrid.innerHTML = state.contracts.map(contract => {
            const yes = contract.yes_price_cents;
            const no = contract.no_price_cents;
            const lead = contract.lead_advocate_side;
            return `
              <div class="bg-[#0B0D13] border border-[#1E2330] rounded-[2px] p-4 flex flex-col justify-between hover:border-purple-500/40 transition shadow-lg">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <div class="flex items-center gap-2">
                      <span class="bg-purple-950 text-purple-300 border border-purple-800 px-2 py-0.5 rounded text-xs font-extrabold tracking-wide">${escapeHtml(contract.ticker)}</span>
                      <span class="text-[10px] text-slate-400 bg-[#141B26] px-1.5 py-0.5 rounded border border-[#1E2330] font-semibold">${escapeHtml(contract.category)}</span>
                    </div>
                    <span class="text-[10px] text-emerald-400 font-bold flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      ${escapeHtml(contract.status)}
                    </span>
                  </div>
                  <h3 class="text-sm font-extrabold text-white leading-snug mb-3 font-sans">${escapeHtml(contract.question)}</h3>
                </div>
                <div class="my-2">
                  <div class="flex justify-between items-center text-xs font-bold mb-1">
                    <span class="text-emerald-400">YES ${yes}¢ (${yes}%)</span>
                    <span class="text-rose-400">NO ${no}¢ (${no}%)</span>
                  </div>
                  <div class="h-3 w-full bg-[#141B26] rounded-full overflow-hidden flex border border-[#1E2330]">
                    <div style="width: ${yes}%" class="bg-gradient-to-r from-emerald-600 to-emerald-400"></div>
                    <div style="width: ${no}%" class="bg-gradient-to-r from-rose-600 to-rose-400"></div>
                  </div>
                </div>
                ${lead ? `
                  <div class="bg-[#07090E] p-2.5 rounded-[2px] border border-[#1E2330] my-3 text-xs leading-relaxed">
                    <div class="flex items-center gap-1.5 text-[10px] font-bold text-amber-400 mb-1">
                      <span>⚡</span>
                      <span>Lead Stance: ${escapeHtml(lead.advocate.replace('_', ' ').toUpperCase())} (${escapeHtml(lead.side)})</span>
                    </div>
                    <p class="text-slate-300 text-[11px] italic font-sans">"${escapeHtml(lead.superstition)}"</p>
                  </div>
                ` : ''}
                <div class="border-t border-[#1E2330] pt-3 mt-2 flex flex-col gap-2.5">
                  <div class="flex items-center justify-between text-[10px] text-slate-500">
                    <span>Vol: ${contract.volume_contracts.toLocaleString()} shs</span>
                    <span>Pool: $${(contract.liquidity_pool_cents / 100).toLocaleString()}</span>
                    <span>Order: Direct Metal</span>
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    <div class="flex flex-col gap-1">
                      <div class="text-[10px] text-emerald-400 font-bold">PILOT BUY YES (${yes}¢)</div>
                      <div class="grid grid-cols-2 gap-1.5">
                        <button onclick="executePilotTrade('${contract.id}', 'YES', 10)" class="bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-700/80 text-emerald-300 font-extrabold py-1.5 px-2 rounded text-[11px] transition shadow cursor-pointer">+$10 YES</button>
                        <button onclick="executePilotTrade('${contract.id}', 'YES', 50)" class="bg-emerald-900 hover:bg-emerald-800 border border-emerald-600 text-emerald-200 font-extrabold py-1.5 px-2 rounded text-[11px] transition shadow cursor-pointer">+$50 YES</button>
                      </div>
                    </div>
                    <div class="flex flex-col gap-1">
                      <div class="text-[10px] text-rose-400 font-bold">PILOT BUY NO (${no}¢)</div>
                      <div class="grid grid-cols-2 gap-1.5">
                        <button onclick="executePilotTrade('${contract.id}', 'NO', 10)" class="bg-rose-950/80 hover:bg-rose-900 border border-rose-700/80 text-rose-300 font-extrabold py-1.5 px-2 rounded text-[11px] transition shadow cursor-pointer">+$10 NO</button>
                        <button onclick="executePilotTrade('${contract.id}', 'NO', 50)" class="bg-rose-900 hover:bg-rose-800 border border-rose-600 text-rose-200 font-extrabold py-1.5 px-2 rounded text-[11px] transition shadow cursor-pointer">+$50 NO</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }
        // 3. Render Live Trade Stream
        const tradesTable = document.getElementById('cockpit-predict-trades');
        if (tradesTable && state.recent_trades) {
          tradesTable.innerHTML = state.recent_trades.map(t => {
            const isYes = t.action.includes('YES');
            const timeStr = new Date(t.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            return `
              <tr class="hover:bg-[#141B26] transition">
                <td class="py-2 px-3 text-slate-500 text-[11px] whitespace-nowrap">${timeStr}</td>
                <td class="py-2 px-3 font-bold text-slate-200 whitespace-nowrap">${escapeHtml(t.advocate.replace('_', ' ').toUpperCase())}</td>
                <td class="py-2 px-3 font-extrabold text-purple-300 whitespace-nowrap">${escapeHtml(t.ticker)}</td>
                <td class="py-2 px-3 whitespace-nowrap">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold ${isYes ? 'bg-emerald-950 text-emerald-300 border border-emerald-800' : 'bg-rose-950 text-rose-300 border border-rose-800'}">
                    ${escapeHtml(t.action)}
                  </span>
                </td>
                <td class="py-2 px-3 font-extrabold text-white">${t.shares}</td>
                <td class="py-2 px-3 text-slate-300">${t.price_cents}¢</td>
                <td class="py-2 px-3 text-amber-300/90 text-[11px] italic max-w-md truncate font-sans">"${escapeHtml(t.superstition_note)}"</td>
              </tr>
            `;
          }).join('');
        }
      } catch (err) {
        console.error('Failed to load predict market:', err);
      }
    }
    async function executePilotTrade(contractId, side, dollarAmount) {
      try {
        const stateRes = await fetch('/api/predict/state');
        const state = await stateRes.json();
        const contract = state.contracts.find(c => c.id === contractId);
        if (!contract) throw new Error('Contract not found');
        const priceCents = side === 'YES' ? contract.yes_price_cents : contract.no_price_cents;
        const shares = Math.max(1, Math.floor((dollarAmount * 100) / priceCents));
        const res = await fetch('/api/predict/trade', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            advocate: 'pilot',
            contract_id: contractId,
            side: side,
            shares: shares,
            superstition: `Pilot Cockpit $${dollarAmount} Instant Execution`
          })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || data.detail || 'Trade execution failed');
        showToast(`Filled: ${shares} shs of ${contract.ticker} ${side} ($${dollarAmount})`);
        loadPredictMarket();
      } catch (err) {
        showToast(err.message || 'Trade execution failed', true);
      }
    }
    // Startup Initialization
    document.addEventListener('DOMContentLoaded', () => {
      const mode = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      updateThemeToggleUI(mode);
      fetchQueueTelemetry();
      fetchApprovals();
      fetchEnvelopes();
      fetchDrops();
      loadCmdbLite();
      // Check URL params for initial active tab
      const urlParams = new URLSearchParams(window.location.search);
      const initialTab = urlParams.get('tab');
      if (initialTab) {
        switchTab('tab-' + initialTab);
      }
      if (urlParams.get('drawer') === 'horizon' || urlParams.get('drawer') === 'open' || window.location.hash === '#horizon-evidence-drawer') {
        openEvidenceDrawer();
      }
      // Poll queue every 5 seconds
      setInterval(fetchQueueTelemetry, 5000);
      // Poll approvals every 10 seconds
      setInterval(fetchApprovals, 10000);
      // Poll CMDB Lite every 10 seconds when tab active
      setInterval(() => {
        const cmdbTab = document.getElementById('tab-cmdb');
        if (cmdbTab && !cmdbTab.classList.contains('hidden')) {
          loadCmdbLite();
        }
      }, 10000);
      // Poll Predict Market every 10 seconds when tab active
      setInterval(() => {
        const predictTab = document.getElementById('tab-predict');
        if (predictTab && !predictTab.classList.contains('hidden')) {
          loadPredictMarket();
        }
      }, 10000);
      // Wire Drag-and-Drop on WO Staging Dropzone & Textarea
      const woDropzone = document.getElementById('wo-dropzone');
      const woTextarea = document.getElementById('stage-wo-content');
      [woDropzone, woTextarea].forEach(el => {
        if (!el) return;
        ['dragenter', 'dragover'].forEach(evt => {
          el.addEventListener(evt, e => {
            e.preventDefault();
            e.stopPropagation();
            el.classList.add('border-amber-500');
          });
        });
        ['dragleave', 'drop'].forEach(evt => {
          el.addEventListener(evt, e => {
            e.preventDefault();
            e.stopPropagation();
            el.classList.remove('border-amber-500');
          });
        });
        el.addEventListener('drop', e => {
          const dt = e.dataTransfer;
          if (dt && dt.files && dt.files.length > 0) {
            parseWoDocumentFile(dt.files[0]);
          }
        });
      });
    });
    // ==================== YOUTUBE SNIPE & FAST WHISPER CLIENT LOGIC ====================
    let currentSnipeData = null;
    function setSnipeUrl(url) {
      const inp = document.getElementById('snipe-url-input');
      if (inp) {
        inp.value = url;
        inp.focus();
      }
    }
    async function triggerYoutubeSnipe() {
      const inp = document.getElementById('snipe-url-input');
      const url = inp ? inp.value.trim() : '';
      if (!url) {
        showToast('Please enter a YouTube video URL', true);
        return;
      }
      const btn = document.getElementById('btn-run-snipe');
      const btnText = document.getElementById('btn-snipe-text');
      const loader = document.getElementById('snipe-loading');
      const resultCard = document.getElementById('snipe-result-card');
      if (btn) btn.disabled = true;
      if (btnText) btnText.textContent = 'Processing...';
      if (loader) loader.classList.remove('hidden');
      if (resultCard) resultCard.classList.add('hidden');
      try {
        const resp = await fetch('/api/cockpit/snipe_youtube', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url })
        });
        const data = await resp.json();
        if (!resp.ok || !data.success) {
          throw new Error(data.error || 'Snipe & Whisper failed');
        }
        currentSnipeData = data;
        displaySnipeResult(data);
        showToast('✓ Audio sniped & transcribed via Whisper');
      } catch (err) {
        console.error(err);
        showToast('Snipe error: ' + err.message, true);
      } finally {
        if (btn) btn.disabled = false;
        if (btnText) btnText.textContent = 'Snipe & Fast Whisper';
        if (loader) loader.classList.add('hidden');
      }
    }
    function displaySnipeResult(data) {
      const resultCard = document.getElementById('snipe-result-card');
      const titleEl = document.getElementById('snipe-result-title');
      const pathEl = document.getElementById('snipe-result-path');
      const idBadge = document.getElementById('snipe-badge-id');
      const durBadge = document.getElementById('snipe-badge-dur');
      const bodyEl = document.getElementById('snipe-transcript-body');
      const kwContainer = document.getElementById('snipe-keywords');
      if (!resultCard) return;
      if (titleEl) titleEl.textContent = data.title || 'Untitled Snipe';
      if (pathEl) pathEl.textContent = data.audio_file || '';
      if (idBadge) idBadge.textContent = 'ID: ' + (data.video_id || '-');
      if (durBadge) durBadge.textContent = (data.duration_secs || 0) + 's';
      if (bodyEl) bodyEl.textContent = data.transcript || '(No transcript content)';
      if (kwContainer) {
        kwContainer.innerHTML = '';
        const transcript = data.transcript || '';
        const candidates = ['Throughput', 'Model-S', 'CapEx', 'Tailscale', 'Telemetry', 'Hardware', 'Latency', 'Postseason', 'Diligence', 'Payback'];
        const found = candidates.filter(k => transcript.toLowerCase().includes(k.toLowerCase()));
        if (found.length === 0) {
          const words = transcript.match(/\b[A-Za-z]{5,}\b/g) || [];
          const freq = {};
          words.forEach(w => {
            const low = w.toLowerCase();
            freq[low] = (freq[low] || 0) + 1;
          });
          const sorted = Object.entries(freq).sort((a,b) => b[1]-a[1]).slice(0, 5);
          sorted.forEach(([w]) => found.push(w));
        }
        found.slice(0, 8).forEach(tag => {
          const pill = document.createElement('span');
          pill.className = 'px-2 py-0.5 rounded bg-[#1B2333] border border-[#2D3A54] text-[10px] font-mono text-cyan-300';
          pill.textContent = '#' + tag;
          kwContainer.appendChild(pill);
        });
      }
      resultCard.classList.remove('hidden');
    }
    function copySnipeTranscript() {
      if (!currentSnipeData || !currentSnipeData.transcript) {
        showToast('No transcript available to copy', true);
        return;
      }
      navigator.clipboard.writeText(currentSnipeData.transcript).then(() => {
        showToast('✓ Transcript copied to clipboard');
      }).catch(err => {
        showToast('Failed to copy: ' + err.message, true);
      });
    }
    function copySnipeMarkdown() {
      if (!currentSnipeData) {
        showToast('No transcript data', true);
        return;
      }
      const md = `### 🎙️ Snipe: ${currentSnipeData.title}\n` +
                 `**Video ID**: \`${currentSnipeData.video_id}\` | **Duration**: ${currentSnipeData.duration_secs}s\n` +
                 `**Audio File**: \`${currentSnipeData.audio_file}\`\n\n` +
                 `#### Transcript:\n> ${currentSnipeData.transcript}\n`;
      navigator.clipboard.writeText(md).then(() => {
        showToast('✓ Markdown snippet copied to clipboard');
      }).catch(err => {
        showToast('Failed to copy: ' + err.message, true);
      });
    }
  </script>
</body>
</html>"""



