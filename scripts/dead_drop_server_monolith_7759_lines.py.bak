      <button onclick="switchTab('tab-sync')" id="btn-sync" class="tab-btn px-3 py-1.5 rounded-[2px] text-xs font-mono font-medium uppercase tracking-wider text-slate-400 hover:text-white hover:bg-[#1E2330] transition flex items-center gap-1.5 border border-transparent">
