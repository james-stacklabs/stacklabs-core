      if (!saved || saved === 'light') {
        saved = 'dark';
        try { localStorage.setItem('stacklabs_theme', 'dark'); } catch(e) {}
      }
      setTheme(saved);
    }
    function setTheme(mode) {
      document.documentElement.classList.add('dark');
      try { localStorage.setItem('stacklabs_theme', 'dark'); } catch(e) {}
      updateThemeToggleUI('dark');
