    function updateThemeToggleUI(mode) {
      const el = document.getElementById('themeToggleText');
      if (!el) return;
      el.innerHTML = '<span class="text-slate-500">☀️ LITE</span> <span class="text-slate-600">/</span> <span class="text-emerald-400 font-bold">🌙 DARK</span>';
    }
    (function() {
