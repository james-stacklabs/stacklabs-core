def seed_verified_coaches():
    """Ensure canonical 2026 coaching records and MLB managers are populated in sys_sports_coaches."""
    with get_db() as conn:
        for team_abbr, roles in VERIFIED_2026_COACHES.items():
            for role, (name, notes) in roles.items():
                cid = f"{team_abbr}_{role}_2026"
                conn.execute("""
                    INSERT INTO sys_sports_coaches (id, team_abbr, sport, coach_name, role, is_active, notes, updated_at)
                    VALUES (?, ?, 'NFL', ?, ?, 1, ?, CURRENT_TIMESTAMP)
                    ON CONFLICT(id) DO UPDATE SET
                        coach_name = excluded.coach_name,
                        role = excluded.role,
                        notes = excluded.notes,
                        updated_at = CURRENT_TIMESTAMP
                """, (cid, team_abbr, name, role, notes))
        
        # Seed MLB Managers (Invariant 45)
        for team_abbr, m_data in VERIFIED_2026_MLB_MANAGERS.items():
            cid = f"{team_abbr}_MGR_2026"
            mgr_name = m_data.get("manager", "")
            notes = m_data.get("notes", m_data.get("predecessor", "Active MLB Manager"))
            conn.execute("""
                INSERT INTO sys_sports_coaches (id, team_abbr, sport, coach_name, role, is_active, notes, updated_at)
                VALUES (?, ?, 'MLB', ?, 'Manager', 1, ?, CURRENT_TIMESTAMP)
                ON CONFLICT(id) DO UPDATE SET
                    coach_name = excluded.coach_name,
                    role = excluded.role,
                    notes = excluded.notes,
                    updated_at = CURRENT_TIMESTAMP
            """, (cid, team_abbr, mgr_name, notes))
            
        conn.commit()


def seed_verified_standings():
    """Ensure baseline 2026 standings are populated in sys_sports_standings."""
    with get_db() as conn:
        for team_abbr, data in VERIFIED_2026_STANDINGS.items():
            conn.execute("""
                INSERT INTO sys_sports_standings (team_abbr, sport, season, wins, losses, ties, streak, last_game_result, last_game_score, updated_at)
                VALUES (?, ?, 2026, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP)
                ON CONFLICT(team_abbr, sport, season) DO UPDATE SET
                    wins = excluded.wins,
                    losses = excluded.losses,
                    ties = excluded.ties,
                    streak = excluded.streak,
                    last_game_result = excluded.last_game_result,
                    last_game_score = excluded.last_game_score,
                    updated_at = CURRENT_TIMESTAMP
            """, (team_abbr, data["sport"], data["wins"], data["losses"], data["ties"], data["streak"], data["last_result"], data["last_score"]))
        conn.commit()


