[Unit]
Description=L2 Arbitrage Edge Scanner Daemon
After=network-online.target tailscale.service
Wants=network-online.target tailscale.service

[Service]
Type=simple
User=james
WorkingDirectory=/home/james/l2_scanner
ExecStart=/home/james/l2_scanner/venv/bin/python scanner.py
Restart=always
RestartSec=10
Environment=NODE_NAME=calvin
Environment=SIGNER_PRIVATE_KEY=your_private_key_here
Environment=ARBITRAGE_CONTRACT_ADDR=0x18_fGVhHn8y1zp85SOQxoLu5DCXmBRd4nzmKCZ3EmZpo

[Install]
WantedBy=multi-user.target
